{
  "name": "swarm-verify",
  "version": "1.3.1",
  "description": "Independent verification for software changes from AI coding agents or humans: runs the project's real checks, separates what passed from what was established, names what stayed unmeasured, and records evidence anyone can check. No model, no key, no configuration.",
  "keywords": [
    "verification",
    "software-verification",
    "ai-coding-agents",
    "coding-agent-verification",
    "ci",
    "github-action",
    "test-verification",
    "code-quality",
    "audit-trail",
    "evidence",
    "hash-chain",
    "provenance",
    "tamper-evident",
    "cli",
    "mcp",
    "pre-commit"
  ],
  "homepage": "https://github.com/moonrunnerkc/swarm-verify#readme",
  "bugs": {
    "url": "https://github.com/moonrunnerkc/swarm-orchestrator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonrunnerkc/swarm-orchestrator.git",
    "directory": "packages/swarm-verify"
  },
  "type": "module",
  "bin": {
    "swarm-verify": "dist/swarm-verify.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-swarm-verify.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "node ../../scripts/validate-verifier-release.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "zod": "^4.4.3"
  },
  "license": "ISC",
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ]
}
