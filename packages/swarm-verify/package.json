{
  "name": "swarm-verify",
  "version": "2.0.0",
  "description": "Measure a candidate change against a project's own checks and declared requirements in a clean checkout, test by test against the base, and sign the result as an in-toto Statement in a DSSE envelope that verify.mjs or cosign can check offline.",
  "keywords": [
    "verification",
    "in-toto",
    "dsse",
    "sigstore",
    "cosign",
    "attestation",
    "held-out-tests",
    "mutation-testing",
    "coverage",
    "ci",
    "github-action",
    "pre-commit",
    "ai-coding-agents"
  ],
  "homepage": "https://github.com/moonrunnerkc/swarm-orchestrator/tree/v13-main/packages/swarm-verify#readme",
  "bugs": {
    "url": "https://github.com/moonrunnerkc/swarm-orchestrator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonrunnerkc/swarm-orchestrator.git",
    "directory": "packages/swarm-verify"
  },
  "type": "module",
  "bin": {
    "swarm-verify": "dist/swarm-verify.js",
    "swarm-verify-mcp": "mcp.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-swarm-verify.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "zod": "^4.4.3"
  },
  "license": "ISC",
  "files": [
    "dist/",
    "verify.mjs",
    "mcp.mjs",
    "action.yml",
    "README.md",
    "CHANGELOG.md"
  ]
}
