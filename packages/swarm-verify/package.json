{
  "name": "swarm-verify",
  "version": "0.1.0",
  "description": "The verification path of swarm-orchestrator on its own: check a signed evidence bundle, verify a patch in a fresh checkout of its base, or run a workspace's gates, with no model, no provider key and no local backend.",
  "keywords": [
    "audit-trail",
    "cli",
    "evidence",
    "hash-chain",
    "provenance",
    "quality-gates",
    "tamper-evident",
    "verification"
  ],
  "homepage": "https://github.com/moonrunnerkc/swarm-orchestrator/blob/v13-main/docs/verify-only.md",
  "bugs": {
    "url": "https://github.com/moonrunnerkc/swarm-orchestrator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonrunnerkc/swarm-orchestrator.git",
    "directory": "packages/swarm-verify"
  },
  "type": "module",
  "bin": {
    "swarm-verify": "dist/swarm-verify.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-swarm-verify.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "zod": "^4.4.3"
  },
