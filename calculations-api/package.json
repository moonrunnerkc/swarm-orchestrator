{
  "name": "calculations-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API that evaluates arithmetic expressions and persists the results to a JSON file.",
  "author": "Bradley R. Kinnard",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test 'test/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' 'test/*.test.js'"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
