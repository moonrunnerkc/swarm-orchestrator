+// Validate underscore placement for PEP 515: underscores only between digits.
+function _validate_underscores (s) {
+    // No consecutive underscores
+    if (/__/.test(s)) return false
+    // Underscore must be between digit/digit or hex/fraction/exponent chars
+    if (/[^\d_]_[^\d_]/.test(s)) return false
+    if (/^_/.test(s) || /_$/.test(s)) return false
+    return true
+}
+
+// Python 3.14 compliant int and float string conversion helpers.
+function _parse_int_string (s) {
+    const stripped = s.trim()
+    // Match: optional sign, then one or more digit groups separated by underscores
+    const digitsOnly = stripped.replace(/[+-]/, '')
+    if (!/^\d(?:_?\d)*$/.test(digitsOnly)) throw null
+    if (!/^[+\-]?\d+$/.test(stripped.replace(/_/g, ''))) throw null
+    // Check underscore validity
+    const cleaned = digitsOnly.replace(/_/g, '')
+    if (!_validate_underscores(digitsOnly)) throw null
+    if (cleaned === '') throw null
+    return Number(cleaned)
+}
+
+function _parse_float_string (s) {
+    const stripped = s.trim()
+    // Case-insensitive check for special float values
+    const lower = stripped.toLowerCase()
+    if (lower === 'inf' || lower === '+inf' || lower === '-inf') {
+        return lower === '-inf' ? -Infinity : Infinity
+    }
+    if (lower === 'infinity' || lower === '+infinity' || lower === '-infinity') {
+        return lower === '-infinity' ? -Infinity : Infinity
+    }
+    if (lower === 'nan') {
+        return NaN
+    }
+    // Must match: optional sign, then (digit sequence optional fraction) optional exponent 
+    // or (optional digit sequence dot digit sequence) optional exponent
+    // Underscores allowed between digits only (PEP 515).
+    
+    // Build regex: allow underscores between numeric characters
+    // Pattern: [+-]?(?=\d)[0-9_]*(\.[0-9_]*)?([eE][+-]?[0-9_]+)? where underscores must be between digits
+    let floatStr = stripped
+    
+    // Validate underscore placement before stripping
+    // Extract numeric part (excluding sign) for validation
+    const afterSign = floatStr.replace(/^[+-]/, '')
+    
+    if (!_validate_underscores(afterSign)) throw null
+    
+    // Remove underscores for conversion
+    floatStr = floatStr.replace(/_/g, '')
+    
+    // Now validate the structure with regex
+    // Match: [+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?
+    const floatRegex = /^[+-]?([0-9]+\.?[0-9]*|\.[0-9]+)([eE][+-]?[0-9]+)?$/
+    if (!floatRegex.test(floatStr)) throw null
+    
+    // Additional check: must have at least one digit and not just "." or empty
+    if (floatStr === '.' || floatStr === '' || floatStr === '+' || floatStr === '-') {
+        throw null
+    }
+    
+    const num = Number(floatStr)
+    return num
+}
+
+// int()-like conversion that returns 0 for '-0'.
+function _string_to_int (s) {
+    try {
+        const result = _parse_int_string(s)
+        if (result === -0) return 0
+        return result
+    } catch (e) {
+        throw new TypeError(sub('could not convert string to int: %r', s))
+    }
+}
+
+// float()-like conversion.
+function _string_to_float (s) {
+    try {
+        return _parse_float_string(s)
+    } catch (e) {
+        throw new TypeError(sub('could not convert string to float: %r', s))
+    }
+}
