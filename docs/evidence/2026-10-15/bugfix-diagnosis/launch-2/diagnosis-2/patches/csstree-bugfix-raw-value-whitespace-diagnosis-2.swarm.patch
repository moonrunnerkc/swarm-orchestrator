diff --git a/debug.js b/debug.js
new file mode 100644
index 0000000..88ac7be
--- /dev/null
+++ b/debug.js
@@ -0,0 +1,51 @@
+import { parse, generate } from './lib/index.js';
+
+const parsed = parse('a{border:1%var(--a)#ff0000}');
+
+function deepVisit(node, depth) {
+    const indent = '  '.repeat(depth);
+    if (node.type === 'Value') {
+        console.log(indent + node.type);
+        for (const child of node.children || []) {
+            deepVisit(child, depth + 1);
+        }
+    } else if (['Raw', 'Percentage', 'Function', 'Identifier', 'Hash', 'Number'].includes(node.type)) {
+        const val = node.value !== undefined ? JSON.stringify(node.value).slice(0, 50) : '(none)';
+        console.log(indent + node.type + ': ' + val);
+    } else if (node.children) {
+        console.log(indent + node.type);
+        for (const child of node.children) {
+            deepVisit(child, depth + 1);
+        }
+    } else if (typeof node.value === 'string') {
+        const val = JSON.stringify(node.value).slice(0, 50);
+        console.log(indent + node.type + ': ' + val);
+    } else {
+        console.log(indent + node.type + '(value)');
+    }
+}
+
+console.log('=== Parsed AST ===');
+// The parsed value should have children: Percentage, Function, Hash
+for (const rule of parsed.children) {
+    for (const decl of rule.children || []) {
+        console.log(decl.type);
+        if (decl.value) {
+            deepVisit(decl.value, 0);
+        }
+    }
+}
+
+console.log('\n=== Raw AST ===');
+const rawAst = parse('a{border:1%var(--a)#ff0000}', { parseValue: false });
+// The raw value should be a single Raw node with full string
+for (const rule of rawAst.children) {
+    for (const decl of rule.children || []) {
+        console.log(decl.type);
+        if (decl.value.type === 'Raw') {
+            console.log('  Raw: ' + JSON.stringify(decl.value.value));
+        } else if (decl.value && decl.value.children) {
+            deepVisit(decl.value, 0);
+        }
+    }
+}
