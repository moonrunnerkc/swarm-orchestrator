diff --git a/src/sinon/stub.js b/src/sinon/stub.js
index 7adc67d311792d7435f52623753a00027dd0d7eb..492f5f828c1f302f57cef2e84dd33db3895ef0ce 100644
--- a/src/sinon/stub.js
+++ b/src/sinon/stub.js
@@ -246,6 +246,32 @@ const proto = {
         this.returnThis = false;
         this.resolveThis = false;
 
+        // Remove stubbed getters and setters (exposed as spies)
+        if (this.rootObj && this.propName !== undefined) {
+            delete this.getter;
+            delete this.setter;
+            const descriptor = Object.getOwnPropertyDescriptor(
+                this.rootObj,
+                this.propName,
+            );
+            if (descriptor && (descriptor.get || descriptor.set)) {
+                // Remove both getter and setter to fully reset the property behavior
+                const newDescriptor = {};
+                if (descriptor.value !== undefined) {
+                    newDescriptor.value = descriptor.value;
+                    newDescriptor.writable = descriptor.writable;
+                }
+                if (descriptor.enumerable !== undefined) {
+                    newDescriptor.enumerable = descriptor.enumerable;
+                }
+                if (descriptor.configurable !== undefined) {
+                    newDescriptor.configurable = descriptor.configurable;
+                }
+                // Delete original accessors but keep value/base property
+                Object.defineProperty(this.rootObj, this.propName, newDescriptor);
+            }
+        }
+
         forEach(this.fakes, function (fake) {
             fake.resetBehavior();
         });
