+/**
+ * Parse a comma-separated list of language ranges from the :lang() argument.
+ * Each range is trimmed, surrounding quotes are stripped, and empty entries are ignored.
+ * @param ranges - The raw string expression from the :lang() selector.
+ * @returns An array of parsed, trimmed, quote-stripped language ranges.
+ */
+function parseLangRanges(ranges: string): string[] {
+    return ranges
+        .split(",")
+        .map((r) => r.trim())
+        .filter((r) => r.length > 0)
+        .map((r) =>
+            (r.startsWith("'") && r.endsWith("'")) ||
+            (r.startsWith('"') && r.endsWith('"'))
+                ? r.slice(1, -1)
+                : r,
+        );
+}
+
+/**
+ * Get the language of an element per Selectors Level 4:
+ * own xml:lang attribute → own lang attribute → nearest ancestor.
+ * @param element - The element whose language is being resolved.
+ * @param adapter - The DOM adapter for attribute access.
+ * @returns The resolved language string, or null if no attributes are found.
+ */
+function getLanguage<Node, ElementNode extends Node>(
+    element: ElementNode,
+    adapter: InternalOptions<Node, ElementNode>["adapter"],
+): string | null {
+    let current: Node | null = element;
+    while (current != null && adapter.isTag(current as any)) {
+        const elementNode = current as unknown as ElementNode;
+        const xmlLang = adapter.getAttributeValue(elementNode, "xml:lang");
+        if (xmlLang !== undefined) return xmlLang;
+        const langAttribute = adapter.getAttributeValue(elementNode, "lang");
+        if (langAttribute !== undefined) return langAttribute;
+        current = adapter.getParent(elementNode);
+    }
+    return null;
+}
+
+/**
+ * Check whether a language tag matches a single RFC 4647 extended filtering range.
+ *
+ * The first subtag of the range must match the tag's first subtag, unless the
+ * range's first subtag is '*'. Then each later non-'*' range subtag must be
+ * found in order among the tag's remaining subtags. Tag subtags of two or more
+ * characters may be skipped; reaching a one-character (singleton) subtag fails
+ * the match.
+ * @param range - A single language range to check.
+ * @param language - The element's resolved language tag.
+ * @returns Whether the range matches the language.
+ */
+function langRangeMatches(range: string, language: string): boolean {
+    if (range === "") return language === "";
+
+    const rangeSubtags = range.split("-").map((s) => s.toLowerCase());
+    const tagSubtags = language.split("-").map((s) => s.toLowerCase());
+
+    /* First subtag must match or be wildcard */
+    if (rangeSubtags[0] !== "*" && rangeSubtags[0] !== tagSubtags[0]) {
+        return false;
+    }
+
+    if (rangeSubtags.length === 1) return true;
+
+    let tagIndex = rangeSubtags[0] === "*" ? 0 : 1;
+
+    for (let index = 1; index < rangeSubtags.length; index++) {
+        const rsub = rangeSubtags[index];
+        if (rsub === "*") continue;
+
+        /* Search in remaining tag subtags, skipping multi-char ones. */
+        let found = false;
+        while (tagIndex < tagSubtags.length) {
+            const tsub = tagSubtags[tagIndex];
+            if (tsub.length === 1) break; /* Hit a singleton */
+            if (rsub === tsub) {
+                tagIndex++;
+                found = true;
+                break;
+            }
+            tagIndex++;
+        }
+
+        if (!found) return false;
+        tagIndex++;
+    }
+
+    return true;
+}
