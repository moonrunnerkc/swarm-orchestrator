+/**
+ * Parse the argument of :lang() into a list of language ranges.
+ * Ranges are trimmed, surrounding quotes removed, empty entries ignored.
+ * @param argument - The raw argument string from the :lang() pseudo-class.
+ */
+function parseLanguageRanges(argument: string): string[] {
+    return argument
+        .split(",")
+        .map((r) => r.trim())
+        .map((r) =>
+            (r.startsWith('"') && r.endsWith('"')) ||
+            (r.startsWith("'") && r.endsWith("'"))
+                ? r.slice(1, -1)
+                : r,
+        )
+        .filter((r) => r !== "");
+}
+
+/**
+ * Get the effective language of an element by looking at xml:lang, then lang
+ * on itself, walking up ancestors if needed.
+ * @param element - The element to check.
+ * @param adapter - The adapter used to access attributes and parent.
+ */
+function getLanguage<Node, ElementNode extends Node>(
+    element: ElementNode,
+    adapter: Adapter<Node, ElementNode>,
+): string {
+    /* Check own attributes first (xml:lang has precedence per Selectors-4). */
+    let v: string | undefined;
+    if (adapter.hasAttrib(element, "xml:lang")) {
+        v = adapter.getAttributeValue(element, "xml:lang");
+        if (typeof v === "string" && v !== "") return v;
+    }
+    if (v === undefined && adapter.hasAttrib(element, "lang")) {
+        v = adapter.getAttributeValue(element, "lang");
+        if (typeof v === "string" && v !== "") return v;
+    }
+
+    /* Walk up ancestors. */
+    const checkNode = (node: ElementNode): string | null => {
+        let nv: string | undefined;
+        if (adapter.hasAttrib(node, "xml:lang")) {
+            nv = adapter.getAttributeValue(node, "xml:lang");
+            if (typeof nv === "string" && nv !== "") return nv;
+        }
+        if (nv === undefined && adapter.hasAttrib(node, "lang")) {
+            nv = adapter.getAttributeValue(node, "lang");
+            if (typeof nv === "string" && nv !== "") return nv;
+        }
+        return null;
+    };
+
+    let current: ElementNode | null = element;
+    do {
+        const langV = checkNode(current);
+        if (langV !== null) return langV;
+        /* Move to the parent. */
+        if (typeof adapter.getParent === "function") {
+            current = adapter.getParent(current) as ElementNode | null;
+        } else {
+            break;
+        }
+    } while (current !== null);
+
+    return "";
+}
+
+/**
+ * Match a single language range against an element's language tag per RFC 4647
+ * §2.3 extended filtering (Selectors-4 §10.3).
+ * @param tag - The element's language tag.
+ * @param range - The language range to match.
+ */
+function matchLanguageRange(tag: string, range: string): boolean {
+    const lowerTag = tag.toLowerCase();
+    const lowerRange = range.toLowerCase();
+
+    const tagSubs = lowerTag.split("-");
+    const rangeSubs = lowerRange.split("-");
+
+    /* The first subtags must be equal (unless the range's is '*'). */
+    if (
+        rangeSubs[0] !== "*" &&
+        (tagSubs.length === 0 || tagSubs[0] !== rangeSubs[0])
+    ) {
+        return false;
+    }
+
+    /* Process remaining range subtags. */
+    let tagPos = 1;
+    for (let ri = 1; ri < rangeSubs.length; ri++) {
+        const rs = rangeSubs[ri];
+        if (rs === "*") continue;
+        /* Find 'rs' in the remaining tag subtags: tagPos..end */
+        /* Tag subtags of length>1 may be skipped; hitting singleton fails */
+        let found = false;
+        while (tagPos < tagSubs.length) {
+            if (tsLength(tagSubs[tagPos]) > 1 && tagSubs[tagPos] !== rs) {
+                tagPos++;
+                continue;
+            }
+            if (tagSubs[tagPos] === rs) {
+                found = true;
+                tagPos++;
+                break;
+            }
+            /* Singleton that doesn't match - fail. */
+            return false;
+        }
+        if (!found) return false;
+    }
+
+    return true;
+}
+
+/* Helper: length of a string in characters */
+function tsLength(s: string): number {
+    return s.length;
+}
