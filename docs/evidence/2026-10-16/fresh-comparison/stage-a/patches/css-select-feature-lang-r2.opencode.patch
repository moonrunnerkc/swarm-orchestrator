+    lang<Node, ElementNode extends Node>(
+        next: CompiledQuery<ElementNode>,
+        text: string,
+        options: InternalOptions<Node, ElementNode>,
+        _context?: Node[],
+    ): CompiledQuery<ElementNode> {
+        // Parse comma-separated language ranges per Selectors Level 4
+        const parts = text.split(",");
+
+        // Remove surrounding quotes (single or double), trim, and filter empty
+        const ranges: string[] = [];
+        for (const part of parts) {
+            let trimmed = part.trim();
+            if (trimmed === "") continue;
+            if (
+                (trimmed.startsWith('"') && trimmed.endsWith('"')) ||
+                (trimmed.startsWith("'") && trimmed.endsWith("'"))
+            ) {
+                trimmed = trimmed.slice(1, -1);
+            }
+            if (trimmed !== "") ranges.push(trimmed.toLowerCase());
+        }
+
+        /* Get the effective language of an element by walking up ancestors. */
+        /* Xml:lang takes precedence over lang at each element. */
+        /* If no attribute found anywhere -> null (matches only empty range). */
+        /* If closest value is "" -> "" (matches only empty range). */
+        function getEffectiveLanguage(elementNode: ElementNode): string | null {
+            let current: ElementNode | null = elementNode;
+            const { adapter } = options;
+            while (current != null) {
+                if (adapter.hasAttrib(current, "xml:lang")) {
+                    return adapter.getAttributeValue(current, "xml:lang") ?? "";
+                }
+                if (adapter.hasAttrib(current, "lang")) {
+                    return adapter.getAttributeValue(current, "lang") ?? "";
+                }
+                current = adapter.getParent(current) as ElementNode | null;
+            }
+            return null;
+        }
+
+        return cacheParentResults(next, options, (elementNode: ElementNode) => {
+            const elementLang = getEffectiveLanguage(elementNode);
+            if (elementLang === null) {
+                /* No language attribute on element or any ancestor */
+                /* Matches only an empty range */
+                return ranges.includes("");
+            }
+            // Check each range case-insensitively
+            return ranges.some((range) => doMatchRange(elementLang, range));
+        });
+    },
 };
 
+/**
+ * Match a single language range against a tag using RFC 4647 extended filtering.
+ * @param tag The language tag to match against.
+ * @param range The language range to test.
+ * @returns Whether the range matches the tag.
+ */
+function doMatchRange(tag: string, range: string): boolean {
+    if (range === "") return true;
+    const tagParts = tag.toLowerCase().split("-");
+    const rangeParts = range.split("-");
+
+    /* First subtag must be equal, unless range's first is '*' */
+    if (rangeParts[0] !== "*" && rangeParts[0] !== tagParts[0]) {
+        return false;
+    }
+
+    let ri = 1;
+    let ti = 1;
+    while (ri < rangeParts.length) {
+        if (rangeParts[ri] === "*") {
+            ri++;
+            continue;
+        }
+        if (ti >= tagParts.length) return false;
+        if (rangeParts[ri] !== tagParts[ti]) {
+            /* A one-character subtag in the tag fails to match */
+            if (tagParts[ti].length <= 1) return false;
+            ti++;
+            continue;
+        }
+        ri++;
+        ti++;
+    }
+
+    return true;
+}
