+        /*
+         * Get the element's language tag by looking up xml:lang first, then lang,
+         * then walking up to the nearest ancestor.
+         */
+        function getLanguage(
+            element: Parameters<typeof adapter.getParent>["0"],
+        ) {
+            let current: typeof element | null = element;
+            while (current != null) {
+                if (adapter.hasAttrib(current, "xml:lang")) {
+                    return adapter.getAttributeValue(current, "xml:lang");
+                }
+                if (adapter.hasAttrib(current, "lang")) {
+                    return adapter.getAttributeValue(current, "lang");
+                }
+                const parent = adapter.getParent(current);
+                current =
+                    parent != null && adapter.isTag(parent) ? parent : null;
+            }
+            return null;
+        }
+
+        /* Check if a single language range matches the tag using RFC 4647 extended filtering. */
+
+        const hasEmptyRange = ranges.includes("");
+
+        return (element) => {
+            const tag = getLanguage(element);
+
+            if (tag == null) {
+                return hasEmptyRange && next(element);
+            }
+
+            if (tag === "") {
+                return hasEmptyRange && next(element);
+            }
+
