+    lang(next, rule, options) {
+        const { adapter } = options;
+        // Parse the comma-separated language ranges from the selector argument
+        const ranges = rule.split(",").map((r) => {
+            let trimmed = r.trim();
+            /*
+             * Remove surrounding quotes (single or double)
+             */
+            if (
+                (trimmed.startsWith('"') && trimmed.endsWith('"')) ||
+                (trimmed.startsWith("'") && trimmed.endsWith("'"))
+            ) {
+                trimmed = trimmed.slice(1, -1);
+            }
+            return trimmed;
+        });
