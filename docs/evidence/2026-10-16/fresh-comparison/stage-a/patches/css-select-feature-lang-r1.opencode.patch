+/*
+ * Check if a single language range matches the tag using RFC 4647 extended filtering.
+ */
+function matchesRFC4647(range: string, tag: string): boolean {
+    const rangeLower = range.toLowerCase();
+    const tagLower = tag.toLowerCase();
+    const rSubs = rangeLower.split("-");
+    const tSubs = tagLower.split("-");
+
+    /* Step 1-2: Check first subtag */
+    if (rSubs[0] !== "*" && tSubs[0] !== rSubs[0]) {
+        return false;
+    }
+
+    let ri = 1;
+    let ti = 1;
+
+    while (ri < rSubs.length && ti < tSubs.length) {
+        if (rSubs[ri] === "*") {
+            ri++;
+            continue;
+        }
+        if (rSubs[ri] === tSubs[ti]) {
+            ri++;
+            ti++;
+            continue;
+        }
+        /* No match at current position; try skipping long tag subtags */
+        let found = false;
+        while (ti < tSubs.length) {
+            if (rSubs[ri] === tSubs[ti]) {
+                ri++;
+                ti++;
+                found = true;
+                break;
+            }
+            /* Can skip tag subtags of length >= 2 */
+            if (tSubs[ti].length <= 1) {
+                break;
+            }
+            ti++;
+        }
+        if (!found) return false;
+    }
+
+    return ri === rSubs.length;
+}
