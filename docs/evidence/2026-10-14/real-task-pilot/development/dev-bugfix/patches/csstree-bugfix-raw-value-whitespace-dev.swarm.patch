+const ast = parse('a{border:1%var(--a)#ff0000}', { parseValue: false });
+walk(ast, (node) => {
+    if (node.type === 'Raw') {
+        console.log('RAW:', JSON.stringify(node.value));
+    }
+});
+console.log('check:', JSON.stringify(generate(ast)));
+
+const rules = parse('span#foo { border: 1%var(--a)#ff0000; }', { parseRulePrelude: false, parseValue: false });
+walk(rules, (node) => {
