--- a/index.js
+++ b/index.js
@@ -117,7 +117,37 @@ export default function pLimit(concurrency) {
 export function limitFunction(function_, options) {
 	const limit = pLimit(options);
 
-	return (...arguments_) => limit(() => function_(...arguments_));
+	const limited = (...arguments_) => limit(() => function_(...arguments_));
+
+	// Forward limiter properties that make sense on the returned function
+	Object.defineProperties(limited, {
+		activeCount: {
+			get() {
+				return limit.activeCount;
+			},
+		},
+		pendingCount: {
+			get() {
+				return limit.pendingCount;
+			},
+		},
+		concurrency: {
+			get() {
+				return limit.concurrency;
+			},
+			set(newConcurrency) {
+				limit.concurrency = newConcurrency;
+			},
+		},
+		clearQueue: {
+			value() {
+				limit.clearQueue();
+			},
+		},
+
+	});
+
+	return limited;
 }
 
 function validateConcurrency(concurrency) {
