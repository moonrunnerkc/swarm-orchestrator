+
+test('limitFunction has clearQueue method', t => {
+	const limitedFunction = limitFunction(async () => 'done', {concurrency: 1});
+
+	t.is(typeof limitedFunction.clearQueue, 'function');
+
+	limitedFunction.clearQueue(); // Should not throw
+});
+
+test('limitFunction clearQueue discards pending calls (rejectOnClear disabled)', async t => {
+	const limited = limitFunction(async x => {
+		await delay(40);
+		return x * 2;
+	}, {concurrency: 1, rejectOnClear: false});
+
+	const firstResult = limited(1);
+	const _secondCall = limited(2);
+	const _thirdCall = limited(3);
+
+	await Promise.resolve();
+	t.is(limited.pendingCount, 2);
+	limited.clearQueue();
+	t.is(limited.pendingCount, 0);
+
+	// First call should resolve with correct result
+	t.is(await firstResult, 2);
+
+	// Second and third calls should never start; their pending promises remain unsettled but that's by design when rejectOnClear is false.
+	await Promise.resolve();
+});
+
+test('limitFunction clearQueue discards pending calls (rejectOnClear enabled)', async t => {
+	const limited = limitFunction(async x => {
+		await delay(40);
+		return x * 2;
+	}, {concurrency: 1, rejectOnClear: true});
+
+	const firstResult = limited(1);
+	const pendingPromiseOne = limited(2);
+	const pendingPromiseTwo = limited(3);
+
+	await Promise.resolve();
+	t.is(limited.pendingCount, 2);
+	limited.clearQueue();
+	t.is(limited.pendingCount, 0);
+
+	t.is(await firstResult, 2);
+
+	await t.throwsAsync(pendingPromiseOne, {name: 'AbortError'});
+	await t.throwsAsync(pendingPromiseTwo, {name: 'AbortError'});
+});
+
+test('limitFunction clearQueue on empty queue is harmless', t => {
+	const limited = limitFunction(async x => x * 2, {concurrency: 1});
+
+	limited.clearQueue(); // Should not throw
+	t.is(limited.activeCount, 0);
+	t.is(limited.pendingCount, 0);
+});
+
+test('limitFunction clearQueue does not affect calls still running', async t => {
+	const limited = limitFunction(async x => {
+		await delay(100);
+		return x;
+	}, {concurrency: 1, rejectOnClear: true});
+
+	const call1 = limited(1); // Starts immediately
+	const pending1 = limited(2); // Waiting
+
+	await Promise.resolve();
+	t.is(limited.activeCount, 1);
+	t.is(limited.pendingCount, 1);
+
+	limited.clearQueue();
+	t.is(limited.pendingCount, 0);
+
+	// The already-running call should still complete
+	t.is(await call1, 1);
+
+	// Pending promises rejected with AbortError
+	await t.throwsAsync(pending1, {name: 'AbortError'});
+});
+
+test('limitFunction clearQueue does not affect separate limited functions', async t => {
+	const optionsA = {concurrency: 1, rejectOnClear: true};
+	const optionsB = {concurrency: 1, rejectOnClear: true};
+	const limitedA = limitFunction(async x => {
+		await delay(50);
+		return 'a' + x;
+	}, optionsA);
+	const limitedB = limitFunction(async y => {
+		await delay(50);
+		return 'b' + y;
+	}, optionsB);
+
+	limitedA('x'); // Starts running
+	limitedB('y'); // Also can run in parallel since they share the same internal pLimit
+
+	await Promise.resolve();
+
+	t.is(limitedA.pendingCount, 0);
+	limitedA.clearQueue(); // Clearing A should not affect B's running call
+
+	// Give the other function time to continue
+	const result = await limitedB('z');
+	t.is(result, 'bz');
+});
+
+test('limitFunction forwards arguments correctly', async t => {
+	const limited = limitFunction((arg1, arg2, arg3) => arg1 + arg2 + arg3, {concurrency: 1});
+
+	const result = await limited(1, 2, 3);
+	t.is(result, 6);
+});
