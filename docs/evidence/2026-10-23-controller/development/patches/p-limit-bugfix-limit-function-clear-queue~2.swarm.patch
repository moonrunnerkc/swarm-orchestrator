@@ -117,7 +117,23 @@ export default function pLimit(concurrency) {
 export function limitFunction(function_, options) {
 	const limit = pLimit(options);
 
-	return (...arguments_) => limit(() => function_(...arguments_));
+	const limited = (...arguments_) => limit(() => function_(...arguments_));
+
+	Object.defineProperty(limited, 'activeCount', {
+		get: () => limit.activeCount,
+	});
+	Object.defineProperty(limited, 'pendingCount', {
+		get: () => limit.pendingCount,
+	});
+	Object.defineProperty(limited, 'concurrency', {
+		get: () => limit.concurrency,
+		set(value) {
+			limit.concurrency = value;
+		},
+	});
+	limited.clearQueue = () => limit.clearQueue();
+
+	return limited;
 }
 
 function validateConcurrency(concurrency) {
