+
+test('limitFunction clearQueue removes pending promises', async t => {
+	const limited = limitFunction(async x => {
+		await delay(100);
+		return x * 2;
+	}, {concurrency: 1, rejectOnClear: true});
+
+	const _result1 = limited(1);
+	const result2 = limited(2);
+	const result3 = limited(3);
+
+	await Promise.resolve();
+	t.is(limited.pendingCount, 2);
+	limited.clearQueue();
+	t.is(limited.pendingCount, 0);
+
+	const r1 = await _result1;
+	t.is(r1, 2);
+
+	await t.throwsAsync(result2, {name: 'AbortError'});
+	await t.throwsAsync(result3, {name: 'AbortError'});
+
+	// Calls after clearing still run normally
+	const result4 = limited(4);
+	const r4 = await result4;
+	t.is(r4, 8);
+});
+
+test('limitFunction clearQueue without rejectOnClear leaves pending promises unsettled', async t => {
+	const limited = limitFunction(async x => {
+		await delay(100);
+		return x * 2;
+	}, {concurrency: 1});
+
+	const _result1 = limited(1);
+	const result2 = limited(2);
+	const result3 = limited(3);
+
+	await Promise.resolve();
+	t.is(limited.pendingCount, 2);
+	limited.clearQueue();
+	t.is(limited.pendingCount, 0);
+
+	// Without rejectOnClear, pending promises stay pending forever
+	const settled = await Promise.race([Promise.any([result2, result3]), new Promise(resolve => {
+		setTimeout(() => resolve('timeout'), 100);
+	})]);
+	t.is(settled, 'timeout');
+
+	// Calls after clearing still work
+	const result4 = limited(4);
+	const r4 = await result4;
+	t.is(r4, 8);
+});
+
+test('limitFunction clearQueue on empty queue is harmless', async t => {
+	const limited = limitFunction(async x => {
+		await delay(10);
+		return x;
+	}, {concurrency: 1});
+
+	limited.clearQueue(); // Should not throw
+	t.is(limited.pendingCount, 0);
+
+	const _result1 = limited('after');
+	const r1 = await _result1;
+	t.is(r1, 'after');
+});
+
+test('limitFunction clearQueue does not affect another limiter', async t => {
+	const limitA = limitFunction(async x => {
+		await delay(100);
+		return x;
+	}, {concurrency: 1});
+
+	const limitB = limitFunction(async x => {
+		await delay(100);
+		return x;
+	}, {concurrency: 1});
+
+	const resultA1 = limitA('a1');
+	const _resultA2 = limitA('a2');
+	const resultB1 = limitB('b1');
+	const _resultB2 = limitB('b2');
+
+	await Promise.resolve();
+	t.is(limitA.pendingCount, 1);
+	t.is(limitB.pendingCount, 1);
+
+	limitA.clearQueue();
+	t.is(limitA.pendingCount, 0);
+	t.is(limitB.pendingCount, 1); // B still has pending
+
+	const ra1 = await resultA1;
+	t.is(ra1, 'a1');
+
+	const rb1 = await resultB1;
+	t.is(rb1, 'b1');
+});
+
+test('limitFunction forwards arguments correctly', async t => {
+	let receivedArgs = null;
+
+	const limited = limitFunction((a, b, c) => {
+		receivedArgs = [a, b, c];
+	}, {concurrency: 1});
+
+	const result = limited(1, 2, 3);
+	await result;
+
+	t.deepEqual(receivedArgs, [1, 2, 3]);
+});
+
+test('limitFunction activeCount and pendingCount work', async t => {
+	const limited = limitFunction(async () => delay(100), {concurrency: 1});
+
+	t.is(limited.activeCount, 0);
+	t.is(limited.pendingCount, 0);
+
+	limited();
+	await Promise.resolve();
+	t.is(limited.activeCount, 1);
+	t.is(limited.pendingCount, 0);
+
+	limited();
+	await Promise.resolve();
+	t.is(limited.activeCount, 1);
+	t.is(limited.pendingCount, 1);
+});
+
+test('limitFunction rejects when function throws synchronously', async t => {
+	const limited = limitFunction(() => {
+		throw new Error('sync error');
+	}, {concurrency: 1});
+
+	await t.throwsAsync(limited(), {message: 'sync error'});
+});
