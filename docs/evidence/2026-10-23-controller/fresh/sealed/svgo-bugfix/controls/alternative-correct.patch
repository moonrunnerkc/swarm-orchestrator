--- /dev/null
+++ b/test/plugins/removeScripts.11.svg.txt
@@ -0,0 +1,26 @@
+Removes the executable links of SVG anchors written with any prefix bound to the
+SVG namespace, and of links whose scheme is split by ASCII tabs or newlines.
+
+===
+
+<svg xmlns="http://www.w3.org/2000/svg" xmlns:s="http://www.w3.org/2000/svg" xmlns:o="https://example.com/o">
+  <s:a href="javascript:alert(1)">
+    <rect width="1" height="1"/>
+  </s:a>
+  <a href="jav&#10;ascript:alert(1)">
+    <rect width="2" height="2"/>
+  </a>
+  <o:a href="javascript:alert(1)">
+    <rect width="3" height="3"/>
+  </o:a>
+</svg>
+
+@@@
+
+<svg xmlns="http://www.w3.org/2000/svg" xmlns:s="http://www.w3.org/2000/svg" xmlns:o="https://example.com/o">
+    <rect width="1" height="1"/>
+    <rect width="2" height="2"/>
+    <o:a href="javascript:alert(1)">
+        <rect width="3" height="3"/>
+    </o:a>
+</svg>
