diff --git a/src/rules_core/strip_references.ts b/src/rules_core/strip_references.ts
new file mode 100644
index 0000000..2cd55c9
--- /dev/null
+++ b/src/rules_core/strip_references.ts
@@ -0,0 +1,11 @@
+// Removes the reference_definition markers the block parser leaves, so the
+// default token stream is the one plugins have always seen. Disable this
+// rule to keep them.
+
+import type StateCore from './state_core.ts'
+
+export default function strip_references (state: StateCore): void {
+  if (!state.tokens.some(token => token.type === 'reference_definition')) { return }
+
+  state.tokens = state.tokens.filter(token => token.type !== 'reference_definition')
+}
