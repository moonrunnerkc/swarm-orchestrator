diff --git a/test.js b/test.js
index e303a46..d984c18 100644
--- a/test.js
+++ b/test.js
@@ -377,0 +378,119 @@ test('limitFunction()', async t => {
+
+test('limitFunction clearQueue discards pending promises', async t => {
+	const limited = limitFunction(async x => {
+		await delay(50);
+		return x * 2;
+	},{concurrency: 1,rejectOnClear: true});
+
+	const first = limited(1);
+	const second = limited(2);
+	const third = limited(3);
+
+	await Promise.resolve();
+	t.is(limited.activeCount, 1);
+	t.true(limited.pendingCount > 0);
+
+	limited.clearQueue();
+	t.is(limited.pendingCount, 0);
+
+	const firstResult = await first;
+	t.is(firstResult, 2);
+
+	await t.throwsAsync(second,{name: 'AbortError'});
+	await t.throwsAsync(third,{name: 'AbortError'});
+});
+
+test('limitFunction clearQueue with default rejectOnClear leaves promises unsettled', async t => {
+	const limited = limitFunction(async x => {
+		await delay(50);
+		return x * 2;
+	},{concurrency: 1});
+
+	const first = limited(1);
+	const second = limited(2);
+
+	await Promise.resolve();
+	t.true(limited.pendingCount > 0);
+
+	limited.clearQueue();
+	t.is(limited.pendingCount, 0);
+
+	const firstResult = await first;
+	t.is(firstResult, 2);
+});
+
+test('limitFunction clearQueue calls run normally', async t => {
+	const limited = limitFunction(async x => {
+		await delay(10);
+		return x * 2;
+	},{concurrency: 1});
+
+	await limited(1);
+	await limited.clearQueue();
+
+	const result = await limited(3);
+	t.is(result, 6);
+});
+
+test('limitFunction clearQueue on empty queue is harmless', async t => {
+	const limited = limitFunction(async () => 'done',{concurrency: 1});
+
+	await Promise.resolve();
+	limited.clearQueue(); // Should not throw
+	t.is(limited.pendingCount, 0);
+});
+
+// Node.js 20 has a bug where DOMException is not properly handled by AVA's `throwsAsync`.
+const testLimitFunctionClearQueueRejects = process.versions.node.startsWith('20.') ? test.skip : test;
+
+testLimitFunctionClearQueueRejects('limitFunction clearQueue rejects pending with AbortError', async t => {
+	const limited = limitFunction(async x => {
+		await delay(50);
+		return x * 2;
+	},{concurrency: 1,rejectOnClear: true});
+
+	// Start a running call
+	const first = limited(1);
+
+	await Promise.resolve();
+
+	// Queue up pending calls
+	const _second = limited(2);
+	const _third = limited(3);
+
+	t.is(limited.activeCount, 1);
+	t.is(limited.pendingCount, 2);
+
+	limited.clearQueue();
+
+	t.is(limited.pendingCount, 0);
+
+	t.is(await first, 2);
+
+	await t.throwsAsync(_second,{name: 'AbortError'});
+	await t.throwsAsync(_third,{name: 'AbortError'});
+});
+
+test('limitFunction clearQueue does not affect separate callers', async t => {
+	const limited1 = limitFunction(async x => {
+		await delay(50);
+		return x * 2;
+	},{concurrency: 1});
+
+	const limited2 = limitFunction(async x => {
+		await delay(50);
+		return x * 2;
+	},{concurrency: 1});
+
+	const p1 = limited1(1);
+	const p2 = limited2(2);
+
+	await Promise.resolve();
+
+	limited1.clearQueue();
+
+	t.is(await p1, 2);
+
+	const result = await p2;
+	t.is(result, 4);
+});
