+
+describe("filterQuery", () => {
+  const filterTests: Array<{
+    input: string;
+    fn: (key: string, value: string | string[]) => boolean;
+    out: string;
+  }> = [
+    {
+      input: "/foo?bar=1&baz=2",
+      fn: (key) => key !== "bar",
+      out: "/foo?baz=2",
+    },
+    {
+      input: "/foo?bar=1",
+      fn: (key) => key !== "bar",
+      out: "/foo",
+    },
+    {
+      input: "/foo?a=1&a=2&bar=3#frag",
+      fn: (key) => key !== "bar",
+      out: "/foo?a=1&a=2#frag",
+    },
+    {
+      input: "/foo?bar=1",
+      fn: () => true,
+      out: "/foo?bar=1",
+    },
+    {
+      input: "/foo?bar=1",
+      fn: () => false,
+      out: "/foo",
+    },
+    {
+      input: "file:///C:/x",
+      fn: () => false,
+      out: "file:///C:/x",
+    },
+    // No query string - return as-is
+    {
+      input: "#hash",
+      fn: () => false,
+      out: "#hash",
+    },
+    {
+      input: "/foo",
+      fn: () => false,
+      out: "/foo",
+    },
+    // filterQuery(input, () => true) should equal withQuery(input, {}) for inputs with "?"
+    {
+      input: "/foo?bar=1&baz=2",
+      fn: () => true,
+      out: withQuery("/foo?bar=1&baz=2", {}),
+    },
+    {
+      input: "/foo?",
+      fn: () => true,
+      out: withQuery("/foo?", {}),
+    },
+    // Repeated params kept/dropped as whole
+    {
+      input: "/foo?a=1&a=2&bar=3",
+      fn: (key) => key !== "bar",
+      out: "/foo?a=1&a=2",
+    },
+    // Encoded values in predicate - decoding is applied
+    {
+      input: "https://example.com/p?q=%20x&bar=1",
+      fn: (key, value) => String(value) !== "1",
+      out: "https://example.com/p?q=+x",
+    },
+    // Empty string with query sign returns filtered result
+    {
+      input: "?a=1&b=2",
+      fn: (key) => key === "a",
+      out: "?a=1",
+    },
+    // Fragment preserved when params removed
+    {
+      input: "/foo?bar=1#frag",
+      fn: () => false,
+      out: "/foo",
+    },
+    // Multiple repeated values - keep whole key
+    {
+      input: "https://x.com?x=a&y=b&type=c&type=d",
+      fn: (key) => key !== "type",
+      out: "https://x.com?x=a&y=b",
+    },
+  ];
+
+  for (const t of filterTests) {
+    test(`${t.input} filtered: ${JSON.stringify(t.out)}`, () => {
+      expect(filterQuery(t.input, t.fn)).toBe(t.out);
+    });
+  }
+});
