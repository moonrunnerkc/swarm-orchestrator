+/**
+ * Filters query parameters from a URL using a predicate function.
+ *
+ * @example
+ *
+ * ```js
+ * filterQuery("/foo?bar=1&baz=2", (key) => key !== "bar"); // "/foo?baz=2"
+ * filterQuery("/foo?bar=1", (key) => key !== "bar"); // "/foo"
+ * filterQuery("/foo?a=1&a=2&bar=3#frag", (key) => key !== "bar"); // "/foo?a=1&a=2#frag"
+ * ```
+ *
+ * @group utils
+ */
+export function filterQuery(
+  input: string,
+  predicate: (key: string, value: string | string[]) => boolean,
+): string {
+  const queryIndex = input.indexOf("?");
+  if (queryIndex === -1) {
+    return input;
+  }
+
+  const beforeQuery = input.slice(0, queryIndex);
+  // The fragment is after any "?" so find it after the query
+  const fragmentStart = input.indexOf("#", queryIndex);
+  let postQuery: string;
+  let fragment: string;
+  if (fragmentStart === -1) {
+    postQuery = input.slice(queryIndex + 1);
+    fragment = "";
+  } else {
+    postQuery = input.slice(queryIndex + 1, fragmentStart);
+    fragment = input.slice(fragmentStart);
+  }
+
+  const parsed: ParsedQuery = parseQuery(postQuery);
+  const keys = Object.keys(parsed);
+
+  // Check if any key passes the predicate
+  let hasMatchingKey = false;
+  for (const k of keys) {
+    if (predicate(k, parsed[k])) {
+      hasMatchingKey = true;
+      break;
+    }
+  }
+
+  if (hasMatchingKey === false) {
+    return beforeQuery || "/";
+  }
+
+  // Rebuild query string from kept keys
+  const keptQuery: QueryObject = {};
+  for (const k of keys) {
+    if (predicate(k, parsed[k])) {
+      keptQuery[k] = parsed[k];
+    }
+  }
+
+  const queryString = stringifyQuery(keptQuery);
+  return beforeQuery + "?" + queryString + fragment;
+}
+
