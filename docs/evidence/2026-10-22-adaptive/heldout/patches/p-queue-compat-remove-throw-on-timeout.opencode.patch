+
+test('.add() - timeout always rejects with TimeoutError', async () => {
+	const queue = new PQueue({timeout: 300});
+	await assert.rejects(queue.add(async () => delay(400)), {name: 'TimeoutError'});
+	await queue.onIdle();
+});
+
+test('.add() - task completes before timeout resolves with value', async () => {
+	const queue = new PQueue({timeout: 300});
+	const result = await queue.add(async () => {
+		await delay(150);
+		return '🐇';
+	});
+	assert.equal(result, '🐇');
+	await queue.onIdle();
+});
+
+test('.add() - per-task timeout overrides queue timeout', async () => {
+	const queue = new PQueue({timeout: 20});
+	// Per-task timeout longer than queue timeout should still resolve
+	const result = await queue.add(async () => {
+		await delay(15);
+		return '🐇';
+	}, {timeout: 300});
+	assert.equal(result, '🐇');
+	// Per-task timeout shorter than queue timeout should reject
+	await assert.rejects(queue.add(async () => delay(15), {timeout: 5}), {name: 'TimeoutError'});
+	await queue.onIdle();
+});
+
+test('.add() - throwOnTimeout passed at runtime is ignored', async () => {
+	const queue = new PQueue({timeout: 300});
+	// Even if throwOnTimeout: false is somehow passed, timeout still rejects
+	await assert.rejects(queue.add(async () => delay(400), {...Object.create(null), throwOnTimeout: false}), {name: 'TimeoutError'});
+	await queue.onIdle();
+});
+
+test('.addAll() - rejects when one task times out', async () => {
+	const queue = new PQueue({timeout: 50});
+
+	let timedOut = false;
+	queue.on('error', () => {
+		timedOut = true;
+	});
+
+	await assert.rejects(queue.addAll([
+		async () => delay(10),
+		async () => delay(200),
+		async () => delay(10),
+	]));
+	assert.ok(timedOut);
+	await queue.onIdle();
+});
+
+test('error event emitted on timeout, no completed event', async () => {
+	const queue = new PQueue({timeout: 50, concurrency: 1});
+	let errorFired = false;
+	let completedFired = false;
+	queue.on('error', () => {
+		errorFired = true;
+	});
+	queue.on('completed', () => {
+		completedFired = true;
+	});
+
+	const result = queue.add(async () => {
+		await delay(200);
+		return '🐌';
+	});
+
+	await assert.rejects(result);
+	assert.ok(errorFired);
+	assert.ok(!completedFired);
+	await queue.onIdle();
+});
+
+test('queue continues after timeout', async () => {
+	const result: string[] = [];
+	const queue = new PQueue({timeout: 50, concurrency: 1});
+
+	await assert.rejects(queue.add(async () => delay(200)));
+
+	await queue.add(async () => {
+		result.push('after');
+		return 'done';
+	});
+
+	await queue.onIdle();
+	assert.deepEqual(result, ['after']);
+});
