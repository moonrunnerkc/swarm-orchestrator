diff --git a/test.js b/test.js
index d7cb024..59a7ea3 100644
--- a/test.js
+++ b/test.js
@@ -333,3 +333,99 @@ test('limitFunction()', async t => {
 
 	await Promise.all(input);
 });
+
+test('rejectOnClear: true rejects pending tasks with AbortError', async t => {
+	const limit = pLimit({concurrency: 1, rejectOnClear: true});
+
+	limit(async () => {
+		await delay(40);
+		return 'task1';
+	});
+
+	const task2Promise = limit(async () => {
+		await delay(40);
+		return 'task2';
+	});
+
+	const task3Promise = limit(async () => {
+		await delay(40);
+		return 'task3';
+	});
+
+	await Promise.resolve();
+	t.is(limit.pendingCount, 2);
+
+	limit.clearQueue();
+	t.is(limit.pendingCount, 0);
+
+	const afterClearTask = limit(async () => 'after-clear');
+
+	try {
+		await task2Promise;
+	} catch (error) {
+		t.truthy(error);
+		t.is(error.name, 'AbortError');
+	}
+
+	try {
+		await task3Promise;
+	} catch (error) {
+		t.truthy(error);
+		t.is(error.name, 'AbortError');
+	}
+
+	t.is(await afterClearTask, 'after-clear');
+	t.pass();
+});
+
+test('rejectOnClear: false behaves as before', async t => {
+	const limit = pLimit({concurrency: 1, rejectOnClear: false});
+
+	limit(async () => delay(40));
+	limit(async () => delay(40));
+
+	await Promise.resolve();
+	t.is(limit.pendingCount, 1);
+
+	limit.clearQueue();
+	t.is(limit.pendingCount, 0);
+});
+
+test('rejectOnClear: undefined behaves as before', async t => {
+	const limit = pLimit({concurrency: 1});
+
+	limit(async () => delay(40));
+	limit(async () => delay(40));
+
+	await Promise.resolve();
+	t.is(limit.pendingCount, 1);
+
+	limit.clearQueue();
+	t.is(limit.pendingCount, 0);
+});
+
+test('rejectOnClear throws TypeError for non-boolean values', t => {
+	t.throws(() => {
+		pLimit({concurrency: 1, rejectOnClear: 'nope'});
+	});
+
+	t.throws(() => {
+		pLimit({concurrency: 1, rejectOnClear: 1});
+	});
+
+	t.throws(() => {
+		pLimit({concurrency: 1, rejectOnClear: null});
+	});
+});
+
+test('limitFunction with rejectOnClear validates the option', t => {
+	t.throws(() => {
+		limitFunction(() => '', {concurrency: 1, rejectOnClear: 'nope'});
+	});
+});
+
+test('limitFunction with rejectOnClear: true works correctly', async t => {
+	const limitedFn = limitFunction(async () => 'ok', {concurrency: 1, rejectOnClear: true});
+
+	await t.notThrowsAsync(limitedFn());
+});
