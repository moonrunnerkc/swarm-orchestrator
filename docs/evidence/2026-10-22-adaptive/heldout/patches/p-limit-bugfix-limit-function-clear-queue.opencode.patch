+
+test('limitFunction clearQueue exists', t => {
+	const limited = limitFunction(async () => 'done', {concurrency: 1});
+	t.is(typeof limited.clearQueue, 'function');
+});
+
+test('limitFunction clearQueue clears pending calls without rejectOnClear', async t => {
+	const limited = limitFunction(async x => {
+		await delay(50);
+		return x * 2;
+	}, {concurrency: 1});
+
+	const first = limited(1);
+	limited.clearQueue();
+	const result = await first;
+	t.is(result, 2);
+});
+
+test('limitFunction clearQueue does not affect already running call', async t => {
+	const limited = limitFunction(async x => {
+		await delay(30);
+		return x * 2;
+	}, {concurrency: 1});
+
+	const first = limited(1);
+	await delay(10);
+	limited.clearQueue();
+	const result = await first;
+	t.is(result, 2);
+});
+
+test('limitFunction clearQueue with rejectOnClear rejects pending calls', async t => {
+	const limited = limitFunction(async x => {
+		await delay(50);
+		return x * 2;
+	}, {concurrency: 1, rejectOnClear: true});
+
+	limited(1);
+	const pendingOne = limited(2);
+	const pendingTwo = limited(3);
+
+	await Promise.resolve();
+
+	limited.clearQueue();
+
+	await t.throwsAsync(pendingOne, {name: 'AbortError'});
+	await t.throwsAsync(pendingTwo, {name: 'AbortError'});
+});
+
+test('limitFunction clearQueue on empty queue is harmless', async t => {
