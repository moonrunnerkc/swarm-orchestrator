diff --git a/test.js b/test.js
index d7cb024..22b2d4c 100644
--- a/test.js
+++ b/test.js
@@ -333,3 +333,121 @@ test('limitFunction()', async t => {
 
 	await Promise.all(input);
 });
+
+test('rejectOnClear throws with invalid value', t => {
+	t.throws(() => pLimit({concurrency: 1, rejectOnClear: 'nope'}), {is: TypeError});
+	t.throws(() => pLimit({concurrency: 1, rejectOnClear: 1}), {is: TypeError});
+	t.throws(() => pLimit({concurrency: 1, rejectOnClear: null}), {is: TypeError});
+});
+
+test('limitFunction rejects invalid rejectOnClear', t => {
+	t.throws(() => limitFunction(() => {}, {concurrency: 1, rejectOnClear: 'nope'}), {is: TypeError});
+});
+
+test('rejectOnClear: true rejects pending promises with AbortError', async t => {
+	const limit = pLimit({concurrency: 1, rejectOnClear: true});
+
+	let startedFirst = false;
+	const tasks = [
+		limit(async () => {
+			startedFirst = true;
+			await delay(50);
+			return 'first';
+		}),
+		limit(async () => 'second'),
+		limit(async () => 'third'),
+	];
+
+	// Let the first task start running
+	await delay(2);
+	t.true(startedFirst);
+	t.is(limit.pendingCount, 2);
+
+	// Clear queue while first is still running
+	limit.clearQueue();
+
+	t.is(limit.pendingCount, 0);
+
+	// First task should resolve normally
+	const [firstResult] = await Promise.allSettled(tasks.slice(0, 1));
+	t.is(firstResult.status, 'fulfilled');
+	t.is(firstResult.value, 'first');
+
+	// Remaining tasks should be rejected with AbortError
+	const remainingResults = await Promise.allSettled(tasks.slice(1));
+	for (const r of remainingResults) {
+		t.is(r.status, 'rejected');
+		t.is(r.reason.name, 'AbortError');
+	}
+});
+
+test('rejectOnClear: false behaves like default clearQueue', async t => {
+	const limit = pLimit({concurrency: 1, rejectOnClear: false});
+
+	limit(() => delay(50));
+	limit(() => delay(50));
+	limit(() => delay(50));
+
+	await delay(2);
+	t.is(limit.pendingCount, 2);
+
+	// Should not throw
+	limit.clearQueue();
+	t.is(limit.pendingCount, 0);
+});
+
+test('rejectOnClear with default (undefined) behaves like clearQueue', async t => {
+	const limit = pLimit({concurrency: 1});
+
+	limit(() => delay(50));
+	limit(() => delay(50));
+
+	await delay(2);
+	t.is(limit.pendingCount, 1);
+
+	limit.clearQueue();
+	t.is(limit.pendingCount, 0);
+});
+
+test('rejectOnClear: true limiter keeps working after clearQueue', async t => {
+	const limit = pLimit({concurrency: 1, rejectOnClear: true});
+
+	limit(() => delay(50));
+	limit(() => 'rejected2');
+	limit(() => 'rejected3');
+
+	await delay(2);
+	limit.clearQueue();
+	t.is(limit.pendingCount, 0);
+
+	// Tasks added after clearQueue should still work
+	const result = await limit(() => 'later');
+	t.is(result, 'later');
+});
+
+test('rejectOnClear: true rejects pending promises at once', async t => {
+	const limit = pLimit({concurrency: 1, rejectOnClear: true});
+	let secondCalled = false;
+
+	limit(async () => delay(50)); // First task runs
+	const third = limit(async () => {
+		secondCalled = true;
+		return 'second';
+	});
+	const fourth = limit(async () => 'third');
+
+	await delay(2);
+	t.is(limit.pendingCount, 2);
+
+	limit.clearQueue();
+
+	// Neither the second nor third should have been called
+	t.false(secondCalled);
+
+	// The promises for pending tasks should reject with AbortError immediately
+	const results = await Promise.allSettled([third, fourth]);
+	for (const r of results) {
+		t.is(r.status, 'rejected');
+		t.is(r.reason.name, 'AbortError');
+	}
+});
