diff --git a/test.js b/test.js
index e303a46..3ad021b 100644
--- a/test.js
+++ b/test.js
@@ -375,3 +375,92 @@ test('limitFunction()', async t => {
 
 	await Promise.all(input);
 });
+
+test('limitFunction returns a function with clearQueue', async t => {
+	const limitedFunction = limitFunction(async x => {
+		await delay(50);
+		return x * 2;
+	}, {concurrency: 1});
+
+	t.is(typeof limitedFunction.clearQueue, 'function');
+
+	// Queue some calls
+	const one = limitedFunction(1);
+	Array.from({length: 3}, () => limitedFunction(null));
+
+	await Promise.resolve();
+	t.is(limitedFunction.pendingCount, 3);
+
+	limitedFunction.clearQueue();
+	t.is(limitedFunction.pendingCount, 0);
+
+	const result = await one;
+	t.is(result, 2);
+});
+
+// Node.js 20 has a bug where DOMException is not properly handled by AVA's `throwsAsync`.
+const testLimitFunctionClearQueueRejects = process.versions.node.startsWith('20.') ? test.skip : test;
+
+testLimitFunctionClearQueueRejects('limitFunction clearQueue rejects pending promises when rejectOnClear is enabled', async t => {
+	const limitedFunction = limitFunction(async x => {
+		await delay(100);
+		return x * 2;
+	}, {concurrency: 1, rejectOnClear: true});
+
+	const runningPromise = limitedFunction(1);
+	const pendingPromiseOne = limitedFunction(2);
+	const pendingPromiseTwo = limitedFunction(3);
+
+	await Promise.resolve();
+	t.is(limitedFunction.pendingCount, 2);
+
+	limitedFunction.clearQueue();
+	t.is(limitedFunction.pendingCount, 0);
+
+	await runningPromise;
+	await t.throwsAsync(pendingPromiseOne, {name: 'AbortError'});
+	await t.throwsAsync(pendingPromiseTwo, {name: 'AbortError'});
+});
+
+test('limitFunction clearQueue with no pending calls is harmless', t => {
+	const limitedFunction = limitFunction(async x => x * 2, {concurrency: 1});
+
+	t.is(limitedFunction.pendingCount, 0);
+	limitedFunction.clearQueue(); // Should not throw
+	t.is(limitedFunction.pendingCount, 0);
+});
+
+test('limitFunction clearQueue does not affect running promise', async t => {
+	const limitedFunction = limitFunction(async x => {
+		await delay(100);
+		return x * 2;
+	}, {concurrency: 1, rejectOnClear: true});
+
+	const runningPromise = limitedFunction(5);
+
+	await Promise.resolve();
+	t.is(limitedFunction.activeCount, 1);
+	t.is(limitedFunction.pendingCount, 0);
+
+	limitedFunction.clearQueue();
+
+	const result = await runningPromise;
+	t.is(result, 10);
+});
+
+test('limitFunction clearQueue does not affect another limiter', async t => {
+	const limitedFunctionA = limitFunction(async x => x * 2, {concurrency: 1});
+	const limitedFunctionB = limitFunction(async x => x + 10, {concurrency: 1});
+
+	limitedFunctionB(1);
+	limitedFunctionB(2);
+
+	await Promise.resolve();
+	t.is(limitedFunctionB.pendingCount, 1);
+
+	limitedFunctionA.clearQueue();
+	t.is(limitedFunctionB.pendingCount, 1); // Unchanged
+
+	limitedFunctionB.clearQueue();
+	t.is(limitedFunctionB.pendingCount, 0);
+});
