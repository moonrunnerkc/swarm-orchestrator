+
+test('limitFunction clearQueue', async t => {
+	const limitedFunction = limitFunction(async x => {
+		await delay(100);
+		return x * 2;
+	}, {concurrency: 1});
+
+	const first = limitedFunction(1);
+	limitedFunction(2);
+	limitedFunction(3);
+
+	await Promise.resolve();
+	t.is(limitedFunction.pendingCount, 2);
+	t.is(limitedFunction.activeCount, 1);
+	limitedFunction.clearQueue();
+	t.is(limitedFunction.pendingCount, 0);
+
+	const result = await first;
+	t.is(result, 2);
+});
+
+test('limitFunction clearQueue with rejectOnClear', async t => {
+	const limitedFunction = limitFunction(async x => {
+		await delay(50);
+		return x * 2;
+	}, {concurrency: 1, rejectOnClear: true});
+
+	const runningPromise = limitedFunction(1);
+	const _pendingOne = limitedFunction(2);
+	const _pendingTwo = limitedFunction(3);
+
+	await Promise.resolve();
+	t.is(limitedFunction.pendingCount, 2);
+
+	limitedFunction.clearQueue();
+	t.is(limitedFunction.pendingCount, 0);
+
+	await runningPromise;
+	await t.throwsAsync(_pendingOne, {name: 'AbortError'});
+	await t.throwsAsync(_pendingTwo, {name: 'AbortError'});
+});
+
+test('limitFunction clearQueue without rejectOnClear leaves promises unsettled', async t => {
+	const limitedFunction = limitFunction(async x => {
+		await delay(50);
+		return x * 2;
+	}, {concurrency: 1, rejectOnClear: false});
+
+	const _running = limitedFunction(1);
+
+	await Promise.resolve();
+	t.is(limitedFunction.activeCount, 1);
+	t.is(limitedFunction.pendingCount, 0);
+
+	const _pending1 = limitedFunction(2);
+	const _pending2 = limitedFunction(3);
+
+	await Promise.resolve();
+	t.is(limitedFunction.activeCount, 1);
+	t.is(limitedFunction.pendingCount, 2);
+
+	limitedFunction.clearQueue();
+	t.is(limitedFunction.pendingCount, 0);
+
+	await _running;
+});
+
+test('limitFunction clearQueue is harmless with no pending', t => {
+	const limitedFunction = limitFunction(async x => x * 2, {concurrency: 1});
+	limitedFunction.clearQueue();
+	t.pass();
+	t.is(limitedFunction.pendingCount, 0);
+});
+
+test('limitFunction clearQueue does not affect separate limiter', async t => {
+	const lim1 = limitFunction(async x => {
+		await delay(50);
+		return x * 2;
+	}, {concurrency: 1});
+	const lim2 = limitFunction(async x => {
+		await delay(50);
+		return x * 2;
+	}, {concurrency: 1});
+
+	lim1(1);
+	lim1(2);
+	await Promise.resolve();
+	t.is(lim1.pendingCount, 1);
+
+	lim1.clearQueue();
+	t.is(lim1.pendingCount, 0);
+
+	const p = lim2(3);
+	const result = await p;
+	t.is(result, 6);
+});
+
+test('limitFunction clearQueue does not cancel running calls', async t => {
+	let resolved = false;
+	const limitedFunction = limitFunction(async x => {
+		await delay(100);
+		resolved = true;
+		return x * 2;
+	}, {concurrency: 1});
+
+	limitedFunction(1);
+	await Promise.resolve();
+
+	limitedFunction(2);
+	limitedFunction(3);
+
+	t.is(limitedFunction.pendingCount, 2);
+
+	limitedFunction.clearQueue();
+	t.is(limitedFunction.pendingCount, 0);
+
+	await delay(150);
+	t.true(resolved);
+});
