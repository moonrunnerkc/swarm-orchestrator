+	let concurrency = 1;
+	let rejectOnClear = false;
+
+	if (typeof options === 'object' && options !== null) {
+		concurrency = options.concurrency ?? 1;
+		if (options.rejectOnClear !== undefined && typeof options.rejectOnClear !== 'boolean') {
+			throw new TypeError('Expected `rejectOnClear` to be a boolean');
+		}
+
+		rejectOnClear = options.rejectOnClear ?? false;
+	} else if (typeof options === 'number' || typeof options === 'bigint') {
+		concurrency = options;
+	}
+
+	if (!((Number.isInteger(concurrency) || concurrency === Number.POSITIVE_INFINITY) && concurrency > 0)) {
+		throw new TypeError('Expected `concurrency` to be a number from 1 and up');
+	}
+
+	const queue = new Queue();
+
+	let activeCount = 0;
+
+	const resumeNext = () => {
+		if (activeCount < concurrency && queue.size > 0) {
+			activeCount++;
+			queue.dequeue().run();
+		}
+	};
+
+	const next = () => {
+		activeCount--;
+		resumeNext();
+	};
+
+	const execute = async (resolve, args_) => {
+		const resultPromise = function_(...args_);
+		resolve(resultPromise);
+
+		try {
+			await resultPromise;
+		} catch {}
+
+		next();
+	};
+
+	const limited = (...args) => new Promise((resolve, reject) => { // eslint-disable-line promise/param-names
+		const queueItem = {reject};
+
+		new Promise(internalResolve => { // eslint-disable-line promise/param-names
+			queueItem.run = internalResolve;
+			queue.enqueue(queueItem);
+		}).then(() => execute(resolve, args)); // eslint-disable-line promise/prefer-await-to-then
+
+		if (activeCount < concurrency) {
+			resumeNext();
+		}
+	});
