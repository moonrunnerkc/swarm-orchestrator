diff --git a/test/throw-on-timeout.ts b/test/throw-on-timeout.ts
new file mode 100644
index 0000000..02609aa
--- /dev/null
+++ b/test/throw-on-timeout.ts
@@ -0,0 +1,119 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import delay from 'delay';
+import PQueue from '../source/index.js';
+
+test('timeout always rejects with TimeoutError', async () => {
+	const queue = new PQueue({timeout: 300});
+	const promise = queue.add(async () => {
+		await delay(400);
+		return '🐌';
+	});
+	await assert.rejects(promise, {name: 'TimeoutError'});
+});
+
+test('task that completes before timeout resolves with value', async () => {
+	const queue = new PQueue({timeout: 300});
+	const result = await queue.add(async () => {
+		await delay(200);
+		return '🦄';
+	});
+	assert.equal(result, '🦄');
+});
+
+test('per-task timeout overrides queue timeout with longer value', async () => {
+	const queue = new PQueue({concurrency: 1, timeout: 200});
+	const result = await queue.add(async () => {
+		await delay(300);
+		return '🐢';
+	}, {timeout: 600});
+	assert.equal(result, '🐢');
+});
+
+test('per-task short timeout overrides queue timeout with shorter value and rejects', async () => {
+	const queue = new PQueue({concurrency: 1, timeout: 300});
+	const promise = queue.add(async () => {
+		await delay(200);
+		return '🐌';
+	}, {timeout: 50});
+	await assert.rejects(promise, {name: 'TimeoutError'});
+});
+
+test('timed-out task emits error event but not completed event', async () => {
+	const queue = new PQueue({timeout: 100});
+	let errored = false;
+	let completedCount = 0;
+	queue.on('error', () => {
+		errored = true;
+	});
+	queue.on('completed', () => {
+		completedCount++;
+	});
+	const promise = queue.add(async () => {
+		await delay(300);
+		return '🐌';
+	});
+	await assert.rejects(promise, {name: 'TimeoutError'});
+	await queue.onIdle();
+	assert.ok(errored, 'error event should be emitted');
+	assert.equal(completedCount, 0, 'completed event should not be emitted for timeout');
+});
+
+test('queue continues processing after a timeout', async () => {
+	const results: string[] = [];
+	const queue = new PQueue({concurrency: 1, timeout: 50});
+	const promise1 = queue.add(async () => {
+		await delay(200);
+		results.push('first');
+	});
+	queue.add(async () => results.push('second'));
+	await assert.rejects(promise1, {name: 'TimeoutError'});
+	const result = await queue.addAll([async () => 'third']);
+	assert.equal(result[0], 'third');
+	await queue.onIdle();
+	assert.deepEqual(results, ['second', 'third']);
+});
+
+test('addAll rejects when one task times out', async () => {
+	const queue = new PQueue({concurrency: 1, timeout: 50});
+	// Add a timed-out task via addAll to test rejection behavior
+	const allPromise = queue.addAll([
+		async () => {
+			await delay(300);
+			return 'first';
+		},
+	]);
+	await assert.rejects(allPromise, {name: 'TimeoutError'});
+});
+
+test('throwOnTimeout option is ignored — timeout always rejects', async () => {
+	const queue = new PQueue({timeout: 100});
+
+	const promise = queue.add(async () => {
+		await delay(300);
+		return '🐌';
+	}, {throwOnTimeout: true});
+	await assert.rejects(promise, {name: 'TimeoutError'});
+});
+
+test('task without timeout runs to completion regardless of duration', async () => {
+	const queue = new PQueue({concurrency: 1});
+	const result = await queue.add(async () => {
+		await delay(300);
+		return '🦄';
+	});
+	assert.equal(result, '🦄');
+});
+
+test('a thrown error from a task still rejects and emits error', async () => {
+	const queue = new PQueue({concurrency: 1});
+	let errorEmitted = false;
+	queue.on('error', error => {
+		errorEmitted = true;
+	});
+	const promise = queue.add(async () => {
+		throw new Error('custom error');
+	});
+	await assert.rejects(promise, {message: 'custom error'});
+	assert.ok(errorEmitted);
+});
