diff --git a/test/timeouts.ts b/test/timeouts.ts
new file mode 100644
index 0000000..2886efa
--- /dev/null
+++ b/test/timeouts.ts
@@ -0,0 +1,167 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {TimeoutError} from 'p-timeout';
+import delay from 'delay';
+import PQueue from '../source/index.js';
+
+test('timeout rejects with TimeoutError (queue-level)', async () => {
+	const queue = new PQueue({timeout: 30});
+	const error = await assert.rejects(
+		queue.add(async () => {
+			await delay(100);
+			return '🐌';
+		}),
+		{name: 'TimeoutError'},
+	);
+	assert(error instanceof TimeoutError);
+	// Queue resumes after timeout
+	const result = await queue.add(async () => {
+		return 'fast';
+	});
+	assert.equal(result, 'fast');
+});
+
+test('timeout rejects with TimeoutError (per-task override)', async () => {
+	const queue = new PQueue({concurrency: 1});
+	const error = await assert.rejects(
+		queue.add(async () => {
+			await delay(100);
+			return '🐌';
+		}, {timeout: 30}),
+		{name: 'TimeoutError'},
+	);
+	assert(error instanceof TimeoutError);
+});
+
+test('task completing before per-task timeout resolves with value', async () => {
+	const queue = new PQueue({concurrency: 1});
+	const result = await queue.add(async () => {
+		await delay(20);
+		return '🦄';
+	}, {timeout: 100});
+	assert.equal(result, '🦄');
+});
+
+test('task completing before queue-level timeout resolves with value', async () => {
+	const queue = new PQueue({timeout: 200, concurrency: 1});
+	const result = await queue.add(async () => {
+		return 'done';
+	});
+	assert.equal(result, 'done');
+});
+
+test('timed-out task emits error event', async () => {
+	let errorEmitted = false;
+	const err: unknown[] = [];
+	const queue = new PQueue({timeout: 30});
+	queue.on('error', (e) => {
+		errorEmitted = true;
+		err.push(e);
+	});
+
+	await assert.rejects(
+		queue.add(async () => {
+			await delay(100);
+			return '🐌';
+		}),
+		{name: 'TimeoutError'},
+	);
+
+	assert(errorEmitted, 'error event should have been emitted');
+	assert(err[0] instanceof TimeoutError, 'error event should be a TimeoutError');
+});
+
+test('timed-out task does NOT emit completed event', async () => {
+	let completedEmitted = false;
+	const queue = new PQueue({timeout: 30});
+	queue.on('completed', () => {
+		completedEmitted = true;
+	});
+
+	await assert.rejects(
+		queue.add(async () => {
+			await delay(100);
+			return '🐌';
+		}),
+		{name: 'TimeoutError'},
+	);
+
+	assert(!completedEmitted, 'completed event should NOT be emitted for timed-out task');
+});
+
+test('queue continues with next tasks after timeout', async () => {
+	const queue = new PQueue({concurrency: 1});
+	queue.add(async () => delay(50));
+
+	await assert.rejects(
+		queue.add(async () => {
+			await delay(200);
+			return '🐌';
+		}, {timeout: 30}),
+		{name: 'TimeoutError'},
+	);
+
+	const result = await queue.add(async () => {
+		return 'later';
+	});
+	assert.equal(result, 'later');
+	await queue.onIdle();
+	assert.equal(queue.size, 0);
+	assert.equal(queue.pending, 0);
+});
+
+test('addAll() rejects when one task times out', async () => {
+	const queue = new PQueue({concurrency: 1, timeout: 50});
+	let secondDone = false;
+
+	const allPromise = queue.addAll([
+		async () => {
+			await delay(200);
+			return 'first';
+		},
+		async () => {
+			await delay(200);
+			secondDone = true;
+			return 'second';
+		},
+	]);
+
+	await assert.rejects(allPromise, {name: 'TimeoutError'});
+
+	// First task times out, queue processes second task after first finishes failing
+	await queue.onIdle();
+	assert(secondDone, 'Second task completed after first timed out');
+});
+
+test('task without timeout runs to completion', async () => {
+	const queue = new PQueue({concurrency: 1});
+	const result = await queue.add(async () => {
+		await delay(200);
+		return 'slow-task-done';
+	});
+	assert.equal(result, 'slow-task-done');
+});
+
+test('per-task timeout overrides queue-level timeout', async () => {
+	const queue = new PQueue({timeout: 30, concurrency: 1});
+
+	// Queue-level is 30ms but per-task override is 200ms, so succeeds
+	const result = await queue.add(async () => {
+		await delay(100);
+		return 'ok';
+	}, {timeout: 200});
+	assert.equal(result, 'ok');
+
+	// Per-task timeout of 30ms overrides queue-level and rejects for a 100ms task
+	await assert.rejects(
+		queue.add(async () => {
+			await delay(100);
+			return 'ok';
+		}, {timeout: 30}),
+		{name: 'TimeoutError'},
+	);
+
+	// Verify queue is still healthy after the timed-out task
+	const result = await queue.add(async () => 'recovered');
+	assert.equal(result, 'recovered');
+});
