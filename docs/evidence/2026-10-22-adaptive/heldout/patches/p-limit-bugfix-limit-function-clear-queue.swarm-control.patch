--- a/index.d.ts
+++ b/index.d.ts
@@ -133,4 +133,16 @@ await Promise.all(input);
 export function limitFunction<Arguments extends unknown[], ReturnType>(
 	function_: (...arguments_: Arguments) => PromiseLike<ReturnType>,
 	options: Options
-): (...arguments_: Arguments) => Promise<ReturnType>;
+): ((...arguments_: Arguments) => Promise<ReturnType>) & {
+	/**
+	Discard pending promises that are waiting to run.
+
+	This is useful if you want to tear down the queue at the end of your program's lifecycle or discard any function calls referencing an intermediary state of your app.
+
+	Note: This does not cancel promises that are already running.
+
+	When `rejectOnClear` is enabled, pending promises are rejected with an `AbortError`.
+	This is recommended if you await the returned promises, for example with `Promise.all`, so pending tasks do not remain unresolved after `clearQueue()`.
+	*/
+	clearQueue: () => void;
+};
diff --git a/index.js b/index.js
index 5ecd392..c8639e4 100644
--- a/index.js
+++ b/index.js
@@ -117,7 +117,28 @@ export default function pLimit(concurrency) {
 export function limitFunction(function_, options) {
 	const limit = pLimit(options);
 
-	return (...arguments_) => limit(() => function_(...arguments_));
+	const limited = (...arguments_) => limit(() => function_(...arguments_));
+
+	Object.defineProperty(limited, 'activeCount', {
+		get: () => limit.activeCount,
+	});
+
+	Object.defineProperty(limited, 'pendingCount', {
+		get: () => limit.pendingCount,
+	});
+
+	Object.defineProperty(limited, 'concurrency', {
+		get: () => limit.concurrency,
+		set(newConcurrency) {
+			limit.concurrency = newConcurrency;
+		},
+	});
+
+	limited.clearQueue = () => {
+		limit.clearQueue();
+	};
+
+	return limited;
 }
 
 function validateConcurrency(concurrency) {
diff --git a/test.js b/test.js
index e303a46..9c725f8 100644
--- a/test.js
+++ b/test.js
@@ -375,3 +375,144 @@ test('limitFunction()', async t => {
 
 	await Promise.all(input);
 });
+
+test('limitFunction().clearQueue exists and is a function', t => {
+	const limitedFunction = limitFunction(async () => {}, {concurrency: 1});
+	t.is(typeof limitedFunction.clearQueue, 'function');
+});
+
+test('limitFunction().clearQueue discards pending promises with default rejectOnClear:false', async t => {
+	const limitedFunction = limitFunction(async x => {
+		await delay(10);
+		return x * 2;
+	}, {concurrency: 1});
+
+	const first = limitedFunction(1);
+	limitedFunction(2);
+	limitedFunction(3);
+
+	await Promise.resolve();
+	t.is(limitedFunction.pendingCount, 2);
+	t.is(limitedFunction.activeCount, 1);
+
+	limitedFunction.clearQueue();
+	t.is(limitedFunction.pendingCount, 0);
+
+	// First should resolve normally since it was running
+	const result = await first;
+	t.is(result, 2);
+
+	// Pending promises cleared stay unsettled but pending count is zero
+	t.is(limitedFunction.pendingCount, 0);
+});
+
+test('limitFunction().clearQueue rejects pending promises when rejectOnClear:true', async t => {
+	const limitedFunction = limitFunction(async x => {
+		await delay(100);
+		return x * 2;
+	}, {concurrency: 1, rejectOnClear: true});
+
+	const runningPromise = limitedFunction(1);
+	const pendingPromiseOne = limitedFunction(2);
+	const pendingPromiseTwo = limitedFunction(3);
+
+	await Promise.resolve();
+	t.is(limitedFunction.pendingCount, 2);
+	t.is(limitedFunction.activeCount, 1);
+
+	limitedFunction.clearQueue();
+	t.is(limitedFunction.pendingCount, 0);
+
+	await runningPromise;
+	await t.throwsAsync(pendingPromiseOne, {name: 'AbortError'});
+	await t.throwsAsync(pendingPromiseTwo, {name: 'AbortError'});
+});
+
+test('limitFunction().clearQueue is harmless when nothing pending', async t => {
+	const limitedFunction = limitFunction(async x => {
+		await Promise.resolve();
+		return x * 2;
+	}, {concurrency: 1});
+
+	const result = await limitedFunction(5);
+	t.is(result, 10);
+	t.is(limitedFunction.pendingCount, 0);
+
+	// Should not throw
+	limitedFunction.clearQueue();
+	t.is(limitedFunction.pendingCount, 0);
+});
+
+test('limitFunction().clearQueue does not affect another limiter', async t => {
+	const limitedOne = limitFunction(async x => {
+		await delay(100);
+		return x * 2;
+	}, {concurrency: 1, rejectOnClear: true});
+
+	const limitedTwo = limitFunction(async x => {
+		await delay(100);
+		return x * 2;
+	}, {concurrency: 1, rejectOnClear: true});
+
+	const oneRunning = limitedOne(1);
+	const onePending = limitedOne(2);
+	const twoPending = limitedTwo(99);
+
+	await Promise.resolve();
+	t.is(limitedOne.pendingCount, 1);
+	t.is(limitedOne.activeCount, 1);
+	t.is(limitedTwo.pendingCount, 0);
+	t.is(limitedTwo.activeCount, 1);
+
+	limitedOne.clearQueue();
+	t.is(limitedOne.pendingCount, 0);
+
+	// One's pending promise is rejected with AbortError
+	await t.throwsAsync(onePending, {name: 'AbortError'});
+
+	// One's running promise resolves normally
+	const oneResult = await oneRunning;
+	t.is(oneResult, 2);
+
+	// Two's promise should resolve fine and not be affected
+	const twoResult = await twoPending;
+	t.is(twoResult, 198);
+});
+
+test('limitFunction() forwards arguments and returns result', async t => {
+	const limitedFunction = limitFunction((a, b, c) => a + b + c, {concurrency: 1});
+	const result = await limitedFunction(1, 2, 3);
+	t.is(result, 6);
+});
+
+test('limitFunction() rejects on sync throw', async t => {
+	const limitedFunction = limitFunction(() => {
+		throw new Error('sync error');
+	}, {concurrency: 1});
+
+	await t.throwsAsync(limitedFunction(), {message: 'sync error'});
+});
+
+// Node.js 20 has a bug where DOMException is not properly handled by AVA's `throwsAsync`.
+const testClearQueueRejectsLimitFunction = process.versions.node.startsWith('20.') ? test.skip : test;
+
+testClearQueueRejectsLimitFunction('limitFunction().clearQueue rejects with AbortError when rejectOnClear:true', async t => {
+	const limitedFunction = limitFunction(async x => {
+		await delay(100);
+		return x * 2;
+	}, {concurrency: 1, rejectOnClear: true});
+
+	const runningPromise = limitedFunction(1);
+	const pendingPromiseOne = limitedFunction(2);
+	const pendingPromiseTwo = limitedFunction(3);
+
+	await Promise.resolve();
+	t.is(limitedFunction.pendingCount, 2);
+
+	limitedFunction.clearQueue();
+	t.is(limitedFunction.pendingCount, 0);
+
+	await runningPromise;
+	await t.throwsAsync(pendingPromiseOne, {name: 'AbortError'});
+	await t.throwsAsync(pendingPromiseTwo, {name: 'AbortError'});
+});
