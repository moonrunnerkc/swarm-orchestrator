diff --git a/test/throw-on-timeout-removed.ts b/test/throw-on-timeout-removed.ts
new file mode 100644
index 0000000..ae6b596
--- /dev/null
+++ b/test/throw-on-timeout-removed.ts
@@ -0,0 +1,144 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import delay from 'delay';
+import PQueue, {TimeoutError} from '../source/index.js';
+
+test('timed-out tasks always reject with TimeoutError', async () => {
+	const queue = new PQueue({concurrency: 1});
+
+	// A task that times out should reject
+	const timedOutTask = queue.add(async () => {
+		await delay(200);
+		return '🐌';
+	}, {timeout: 50});
+
+	await assert.rejects(timedOutTask, {name: 'TimeoutError'});
+});
+
+test('queue.add resolves with value when task completes before timeout', async () => {
+	const queue = new PQueue({concurrency: 1});
+
+	const result = await queue.add(async () => {
+		await delay(50);
+		return '🦄';
+	}, {timeout: 300});
+
+	assert.equal(result, '🦄');
+});
+
+test('per-task timeout overrides queue timeout', async () => {
+	const queue = new PQueue({timeout: 100});
+
+	// This should complete because per-task timeout is longer than task duration
+	const result = await queue.add(async () => {
+		await delay(50);
+		return '🏇';
+	}, {timeout: 300});
+
+	assert.equal(result, '🏇');
+
+	// This should reject because per-task timeout is shorter
+	const timedOutTask = queue.add(async () => {
+		await delay(200);
+		return '🐌';
+	}, {timeout: 50});
+
+	await assert.rejects(timedOutTask, {name: 'TimeoutError'});
+});
+
+test('queue.timeout applies to tasks added after it is set', async () => {
+	const queue = new PQueue();
+	queue.timeout = 100;
+
+	const result = await queue.add(async () => {
+		await delay(50);
+		return '🦅';
+	});
+
+	assert.equal(result, '🦅');
+
+	queue.timeout = 50;
+	const timedOutTask = queue.add(async () => {
+		await delay(200);
+		return '🐌';
+	});
+
+	await assert.rejects(timedOutTask, {name: 'TimeoutError'});
+});
+
+test('timed-out task emits error event but no completed event', async () => {
+	const queue = new PQueue({timeout: 50});
+	let errorEmitted = false;
+	queue.on('error', error => {
+		if (error.name === 'TimeoutError') {
+			errorEmitted = true;
+		}
+	});
+
+	await assert.rejects(queue.add(async () => {
+		await delay(200);
+		return '🐌';
+	}), {name: 'TimeoutError'});
+
+	assert.ok(errorEmitted, 'error event should be emitted for timeout');
+});
+
+test('queue continues processing after a timed-out task', async () => {
+	const order: string[] = [];
+	const queue = new PQueue({concurrency: 1, timeout: 50});
+
+	queue.add(async () => {
+		await delay(10);
+		order.push('task3');
+	});
+
+	const rejected = queue.add(async () => {
+		await delay(200);
+		order.push('task1');
+	});
+	await assert.rejects(rejected, {name: 'TimeoutError'});
+
+	queue.add(async () => {
+		await delay(10);
+		order.push('task2');
+	});
+
+	await queue.onIdle();
+	assert.deepEqual(order, ['task3', 'task2']);
+});
+
+test('addAll() rejects when one of its tasks times out', async () => {
+	const queue = new PQueue({concurrency: 2, timeout: 50});
+	let errorEmitted = false;
+	queue.on('error', error => {
+		if (error.name === 'TimeoutError') {
+			errorEmitted = true;
+		}
+	});
+
+	const allPromise = queue.addAll([
+		async () => {
+			await delay(10);
+			return 'fast';
+		},
+		async () => {
+			await delay(200);
+			return 'slow';
+		},
+	]);
+
+	await assert.rejects(allPromise, {name: 'TimeoutError'});
+	assert.ok(errorEmitted);
+});
+
+test('throwOnTimeout passed at runtime is ignored (timeout still rejects)', async () => {
+	const queue = new PQueue();
+
+	// Even if someone passes throwOnTimeout, the timeout should still reject
+	const timedOutTask = queue.add(async () => {
+		await delay(200);
+		return '🐌';
+	}, {timeout: 50, throwOnTimeout: false});
+
+	await assert.rejects(timedOutTask, {name: 'TimeoutError'});
+});
