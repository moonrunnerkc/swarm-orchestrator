+function partition<T>(
+  f: (x: T, index: number, arr: T[]) => boolean,
+  list?: T[]
+): any {
+  switch (arguments.length) {
+    case 1:
+      return (list: T[]) => partition(f, list)
+    default:
+      const accepted: T[] = []
+      const rejected: T[] = []
+      for (let i = 0; i < list!.length; i++) {
+        if (f(list![i]!, i, list!)) {
+          accepted.push(list![i]!)
+        } else {
+          rejected.push(list![i]!)
+        }
+      }
+      return Tuple(accepted, rejected)
+  }
+}
