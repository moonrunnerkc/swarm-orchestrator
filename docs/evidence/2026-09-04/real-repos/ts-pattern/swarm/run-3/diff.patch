+/**
+ * `P.object` is a wildcard pattern, matching any **non-null object** (including arrays, Maps and Sets).
+ *
+ * [Read the documentation for `P.object` on GitHub](https://github.com/gvergnaud/ts-pattern#pobject-wildcard)
+ *
+ * @example
+ *   .with(P.object, () => 'will match non-null objects')
+ */
+export const object: ObjectChainable<GuardP<unknown, object>, never> = chainable(
+  when((value): value is object => typeof value === 'object' && value !== null)
+);
+
+/**
+ * `P.object.empty` is a pattern matching **non-null objects** that are not arrays, Maps or Sets, and have no own enumerable keys.
+ * Includes `{}` and `Object.create(null)` but excludes `{a: 1}`, `[]`, `new Map()`, `new Set()`.
+ *
+ * @example
+ *   .with(P.object.empty, () => 'will match empty objects')
+ */
+object.empty = {
+  [matcher]() {
+    return {
+      match: <UnknownInput>(value: UnknownInput | object) => {
+        if (typeof value !== 'object' || value === null) {
+          return { matched: false };
+        }
+        if (Array.isArray(value)) {
+          return { matched: false };
+        }
+        if (value instanceof Map || value instanceof Set) {
+          return { matched: false };
+        }
+        return Reflect.ownKeys(value).length === 0
+          ? { matched: true }
+          : { matched: false };
+      },
+    };
+  },
+} as ObjectChainable<ObjectEmptyPattern, never>;
