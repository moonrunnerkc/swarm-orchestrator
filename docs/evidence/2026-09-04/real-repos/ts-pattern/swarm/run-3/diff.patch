+type ObjectEmptyMatcher = {
+  [matcher](): {
+    match: <I>(value: I | object) => MatchResult;
+  };
+};
+
+export type ObjectChainable<p, omitted extends string = never> = Chainable<p, omitted> &
+  Omit<
+    {
+      /**
+       * `P.object.empty` is a pattern matching **non-null objects** that are not arrays, Maps or Sets,
+       * and have no own enumerable keys. Includes `{}` and `Object.create(null)`.
+       */
+      empty?: ObjectChainable<ObjectEmptyPattern>;
+    },
+    omitted
+  >;
+
+export type ObjectEmptyPattern = GuardP<unknown, object>;
