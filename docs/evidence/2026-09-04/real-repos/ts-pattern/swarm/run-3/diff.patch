+
+    it('.optional() should work on P.object.empty', () => {
+      const pattern = { val: (P.object.empty as any).optional() };
+
+      expect(isMatching(pattern, { val: {} })).toBe(true);
+      expect(isMatching(pattern, { val: null })).toBe(false);
+      expect(isMatching(pattern, {})).toBe(true); // undefined matches optional
+      expect(isMatching(pattern, { val: { a: 1 } })).toBe(false);
+    });
+
+    it('.and() should work on P.object.empty', () => {
+      const pattern = (P.object.empty as any).and(P.when(() => true));
+
+      expect(isMatching(pattern, {})).toBe(true);
+      expect(isMatching(pattern, { a: 1 })).toBe(false);
+      expect(isMatching(pattern, null)).toBe(false);
+    });
+
+    it('.or() should work on P.object.empty', () => {
+      const pattern = (P.object.empty as any).or(P.string);
+
+      expect(isMatching(pattern, {})).toBe(true);
+      expect(isMatching(pattern, 'hello')).toBe(true);
+      expect(isMatching(pattern, { a: 1 })).toBe(false);
+      expect(isMatching(pattern, null)).toBe(false);
+    });
+
+    it('.select() should work on P.object.empty', () => {
+      const fn = (input: unknown) =>
+        match(input)
+          .with({ val: (P.object.empty as any).select() }, (value) => value)
+          .otherwise(() => null);
+
+      expect(fn({ val: {} })).toEqual({});
+      expect(fn({ val: Object.create(null) })).toEqual(Object.create(null));
+    });
+  });
+});
