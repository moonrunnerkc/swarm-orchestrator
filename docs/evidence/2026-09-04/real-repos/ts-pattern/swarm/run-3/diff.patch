+describe('P.object', () => {
+  it('should match plain objects with isMatching', () => {
+    expect(isMatching(P.object, {})).toBe(true);
+    expect(isMatching(P.object, { a: 1 })).toBe(true);
+    expect(isMatching(P.object, Object.create(null))).toBe(true);
+    // non-objects should not match
+    expect(isMatching(P.object, null)).toBe(false);
+    expect(isMatching(P.object, undefined)).toBe(false);
+    expect(isMatching(P.object, 'string')).toBe(false);
+    expect(isMatching(P.object, 42)).toBe(false);
+    expect(isMatching(P.object, true)).toBe(false);
+  });
+
+  it('should match arrays, Maps and Sets with isMatching', () => {
+    expect(isMatching(P.object, [])).toBe(true);
+    expect(isMatching(P.object, [1, 2])).toBe(true);
+    expect(isMatching(P.object, new Map())).toBe(true);
+    expect(isMatching(P.object, new Map([['a', 1]]))).toBe(true);
+    expect(isMatching(P.object, new Set())).toBe(true);
+    expect(isMatching(P.object, new Set([1]))).toBe(true);
+  });
+
+  it('should work with match().with()', () => {
+    const fn = (input: unknown) =>
+      match(input)
+        .with(P.object, (value) => {
+          type t = Expect<Equal<typeof value, object>>;
+          return 'object';
+        })
+        .otherwise(() => 'not object');
+
+    expect(fn({})).toBe('object');
+    expect(fn({ a: 1 })).toBe('object');
+    expect(fn([])).toBe('object');
+    expect(fn(new Map())).toBe('object');
+    expect(fn(new Set())).toBe('object');
+    expect(fn(Object.create(null))).toBe('object');
+    expect(fn(null)).toBe('not object');
+    expect(fn(undefined)).toBe('not object');
+    expect(fn('hello')).toBe('not object');
+    expect(fn(42)).toBe('not object');
+  });
+
+  it('.optional() should work on P.object', () => {
+    const pattern = { val: P.object.optional() };
+
+    expect(isMatching(pattern, { val: {} })).toBe(true);
+    expect(isMatching(pattern, { val: null })).toBe(false);
+    expect(isMatching(pattern, {})).toBe(true); // undefined optionals match
+    expect(isMatching(pattern, { val: [1] })).toBe(true);
+  });
+
+  it('.and() should work on P.object', () => {
+    const pattern = P.object.and(P.when((val) => (val as object) !== null && 'a' in val));
+
+    expect(isMatching(pattern, { a: 1 })).toBe(true);
+    expect(isMatching(pattern, {})).toBe(false);
+    expect(isMatching(pattern, [1])).toBe(false); // array doesn't have 'a' property-like key
+  });
+
+  it('.or() should work on P.object', () => {
+    const pattern = P.object.or(P.string);
+
+    expect(isMatching(pattern, {})).toBe(true);
+    expect(isMatching(pattern, 'hello')).toBe(true);
+    expect(isMatching(pattern, null)).toBe(false);
+    expect(isMatching(pattern, 42)).toBe(false);
+  });
+
+  it('.select() should work on P.object', () => {
+    const fn = (input: unknown) =>
+      match(input)
+        .with(P.select(), (value) => value)
+        .otherwise(() => null);
+
+    expect(fn({ x: 1 })).toEqual({ x: 1 });
+    expect(fn([])).toEqual([]);
+    expect(fn(new Map())).toEqual(new Map());
+  });
+
+  describe('P.object.empty', () => {
+    it('should match plain empty objects with isMatching', () => {
+      expect(isMatching(P.object.empty!, {})).toBe(true);
+      expect(isMatching(P.object.empty!, Object.create(null))).toBe(true);
+      // non-empty should not match
+      expect(isMatching(P.object.empty, { a: 1 })).toBe(false);
+      expect(isMatching(P.object.empty, { a: 1, b: 2 })).toBe(false);
+    });
+
+    it('should not match arrays, Maps or Sets', () => {
+      expect(isMatching(P.object.empty as any, [])).toBe(false);
+      expect(isMatching(P.object.empty as any, [1])).toBe(false);
+      expect(isMatching(P.object.empty as any, new Map())).toBe(false);
+      expect(isMatching(P.object.empty as any, new Map([['a', 1]]))).toBe(false);
+      expect(isMatching(P.object.empty as any, new Set())).toBe(false);
+    });
+
+    it('should not match null or undefined', () => {
+      expect(isMatching(P.object.empty as any, null)).toBe(false);
+      expect(isMatching(P.object.empty as any, undefined)).toBe(false);
+    });
+
+    it('should work with match().with()', () => {
+      const fn = (input: unknown) =>
