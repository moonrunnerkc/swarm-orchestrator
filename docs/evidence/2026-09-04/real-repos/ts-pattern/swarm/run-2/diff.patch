+/**
+ * `P.object` is a wildcard pattern, matching any value whose `typeof` is `"object"` and which is not `null`.
+ * Includes arrays, Maps, Sets, and plain objects.
+ *
+ * [Read the documentation for `P.object` on GitHub](https://github.com/gvergnaud/ts-pattern#pobject-wildcard)
+ *
+ * @example
+ *   .with(P.object, () => 'will match on objects (including arrays, maps, sets)')
+ */
+export function object<input>(): Chainable<GuardP<unknown, object>, never>;
+export function object<input, const pattern extends Pattern<Extract<input, object>>>(
+  pattern: pattern
+): ObjectChainable<GuardP<input, Extract<input, object>>>;
+export function object<input>(): Chainable<GuardP<unknown, object>, never>;
+export function object<input, const pattern extends Pattern<Extract<input, object>>>(
+  pattern: pattern
+): ObjectChainable<GuardP<input, Extract<input, object>>>;
+export function object(
+  ...args: [pattern?: unknown]
+): Chainable<GuardP<unknown, object>, never> | ObjectChainable<GuardP<unknown, object>, never> {
+  if (args.length === 0) {
+    return chainable({
+      [matcher]() {
+        return {
+          match: <UnknownInput>(value: UnknownInput) => {
+            const result = value !== null && typeof value === 'object'
+              ? { matched: true, selections: {} as Record<string, unknown> }
+              : { matched: false, selections: {} as Record<string, unknown> };
+            return result;
+          },
+          getSelectionKeys: () => [],
+        };
+      },
+    });
+  }
+  const pattern = args[0];
+  return Object.assign(chainable({
+    [matcher]() {
+      return {
+        match: <UnknownInput>(value: UnknownInput) => {
+          if (value === null || typeof value !== 'object') {
+            return { matched: false, selections: {} as Record<string, unknown> };
+          }
+          const selector = (key: string, _v: unknown) => {};
+          const matched = matchPattern(pattern, value, selector);
+          if (typeof matched === 'boolean') {
+            return { matched, selections: {} as Record<string, unknown> };
+          }
+          return { ...matched, selections: matched.selections || {} };
+        },
+        getSelectionKeys: () => [
+          ...(args[0] ? getSelectionKeys(args[0]) : []),
+        ],
+      };
+    },
+  }), {
+    empty: (): GuardP<unknown, object> => when(isEmptyObject),
+  }) as ObjectChainable<GuardP<unknown, object>, never>;
+}
+
+// Guard for `P.object.empty`: not null, not undefined, typeof == "object", not array, not Map, not Set, and has no own enumerable keys
+function isEmptyObject(x: unknown): x is object {
+  return (
+    x !== null &&
+    x !== undefined &&
+    typeof x === 'object' &&
+    !Array.isArray(x) &&
+    !(x instanceof Map) &&
+    !(x instanceof Set) &&
+    Object.keys(x).length === 0
+  );
+}
+
+export function objectEmpty(): Chainable<GuardP<unknown, object>> {
+  return chainable(when(isEmptyObject));
+}
+
+/**
+ * `P.object.empty` is a wildcard pattern matching only values that match P.object
+ * (i.e. typeof "object" and not null), that are not arrays, Maps, Sets, and that have
+ * zero own enumerable property keys, so `{}` and `Object.create(null)` match it but
+ * `{ a: 1 }`, `[]`, `new Map()`, `new Set()`, `null` and `undefined` do not.
+ */
+export const object = { ...chainable(when(isUnknown)), _object_: true };
