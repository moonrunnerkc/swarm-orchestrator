+function isObject(value: unknown): value is object {
+	return typeof value === 'object' && value !== null;
+}
+
+/**
+ * `P.object.empty` checks that the value is a non-null object, not an array, Map, or Set,
+ * and has no own enumerable property keys.
+ */
+function isEmptyObject(value: unknown): value is object {
+	return (
+		isObject(value) &&
+		!Array.isArray(value) &&
+		!(value instanceof Map) &&
+		!(value instanceof Set) &&
+		Object.keys(value).length === 0
+	);
+}
+
+const emptyPattern = chainable(when(isEmptyObject));
+
+const objectChainable = <pattern extends Matcher<any, any, any, any, any>>(
+	pattern: pattern
+): ObjectChainable<pattern> =>
+	Object.assign(chainable(pattern), {
+		empty: emptyPattern as Chainable<GuardP<unknown, object & {}>, 'empty'>,
+	}) as unknown as ObjectChainable<pattern>;
+
+/**
+ * `P.object` is a wildcard pattern, matching any **object** (non-null).
+ * Includes arrays, Maps, Sets, plain objects, and custom class instances.
+ *
+ * [Read the documentation for `P.object` on GitHub](https://github.com/gvergnaud/ts-pattern#pobject-wildcard)
+ *
+ * @example
+ *  match(value)
+ *   .with(P.object, () => 'will match on objects')
+ */
+export const object: ObjectWildcardPattern = objectChainable(when(isObject));
+
