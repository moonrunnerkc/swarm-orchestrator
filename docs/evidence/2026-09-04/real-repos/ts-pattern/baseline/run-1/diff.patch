+/**
+ * `P.object` is a wildcard pattern, matching any **object** (non-null).
+ * Includes arrays, Maps, Sets, plain objects, and custom class instances.
+ */
+export type ObjectChainable<p> = p & {
+  readonly [k: PropertyKey]: unknown;
+  /**
+   * `P.object.empty` matches only plain empty objects (not arrays, Maps, or Sets).
+   * `{}` and `Object.create(null)` match it; `{ a: 1 }`, `[]`, `new Map()`,
+   * `new Set()`, `null`, and `undefined` do not.
+   */
+  empty: Chainable<GuardP<unknown, object & {}>, 'empty'>;
+};
+
+/**
+ * Pattern type for the `P.object` wildcard that matches any non-null **object**.
+ * Includes arrays, Maps, Sets, plain objects, and custom class instances.
+ */
+export type ObjectWildcardPattern = ObjectChainable<GuardP<unknown, object>>;
