+describe('P.object', () => {
+  describe('runtime matching', () => {
+    it('matches plain objects', () => {
+      expect(isMatching(P.object, { a: 1 })).toBe(true);
+      expect(isMatching(P.object, {})).toBe(true);
+      expect(isMatching(P.object, Object.create(null))).toBe(true);
+    });
+
+    it('matches arrays', () => {
+      expect(isMatching(P.object, [])).toBe(true);
+      expect(isMatching(P.object, [1, 2, 3])).toBe(true);
+    });
+
+    it('matches Maps and Sets', () => {
+      expect(isMatching(P.object, new Map())).toBe(true);
+      expect(isMatching(P.object, new Map([['a', 1]]))).toBe(true);
+      expect(isMatching(P.object, new Set())).toBe(true);
+      expect(isMatching(P.object, new Set([1, 2]))).toBe(true);
+    });
+
+    it('matches class instances', () => {
+      class Custom {}
+      expect(isMatching(P.object, new Custom())).toBe(true);
+    });
+
+    it('does not match null or undefined', () => {
+      expect(isMatching(P.object, null)).toBe(false);
+      expect(isMatching(P.object, undefined)).toBe(false);
+    });
+
+    it('does not match primitives', () => {
+      expect(isMatching(P.object, 'hello')).toBe(false);
+      expect(isMatching(P.object, 42)).toBe(false);
+      expect(isMatching(P.object, true)).toBe(false);
+      expect(isMatching(P.object, Symbol('test'))).toBe(false);
+    });
+
+    describe('P.object.empty', () => {
