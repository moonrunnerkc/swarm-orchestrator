+describe('P.object', () => {
+  it('matches objects whose typeof is "object" and are not null', () => {
+    // plain object
+    expect(isMatching(P.object, {} as unknown)).toBe(true);
+    expect(isMatching(P.object, { a: 1 } as unknown)).toBe(true);
+
+    // array
+    expect(isMatching(P.object, [1, 2, 3] as unknown)).toBe(true);
+
+    // Map
+    expect(isMatching(P.object, new Map() as unknown)).toBe(true);
+    expect(isMatching(P.object, new Map([['k', 'v']]) as unknown)).toBe(true);
+
+    // Set
+    expect(isMatching(P.object, new Set() as unknown)).toBe(true);
+    expect(isMatching(P.object, new Set([1, 2]) as unknown)).toBe(true);
+
+    // Object.create(null)
+    expect(isMatching(P.object, Object.create(null) as unknown)).toBe(true);
+
+    // Date instance (has typeof "object")
+    expect(isMatching(P.object, new Date() as unknown)).toBe(true);
+
+    // Function instance (has typeof "function", NOT "object")
+    expect(isMatching(P.object, (() => {}) as unknown)).toBe(false);
+  });
+
+  it('does not match null or undefined', () => {
