+      .otherwise(() => 'unexpected' as const);
+    expect(result1).toBe('present or missing');
+
+    const result2 = match<{ x: object | undefined }>({ x: undefined })
+      .with({ x: P.object.empty.optional() }, () => 'present or missing')
+      .otherwise(() => 'unexpected' as const);
+    expect(result2).toBe('present or missing');
+
+    const result3 = match<{ x: object }>({ x: {} as object })
+      .with({ x: P.object.empty.optional() }, () => 'empty')
+      .otherwise(() => 'not empty' as const);
+    expect(result3).toBe('empty');
+
+    const result4 = match<{ x: object }>({ x: { a: 1 } as object })
+      .with({ x: P.object.empty.optional() }, () => 'unexpected' as const)
+      .otherwise(() => 'not empty' as const);
+    expect(result4).toBe('not empty');
+  });
+
+  it('should support .and() on P.object.empty', () => {
+    const result = match<unknown>({} as object)
+      .with(P.object.empty.and(P.when((v): v is object => typeof v === 'object' && v !== null)), () => 'matched')
+      .otherwise(() => 'nope' as const);
+    expect(result).toBe('matched');
+  });
+
+  it('should support .or() on P.object.empty', () => {
+    const result1 = match<unknown>({} as object)
+      .with(P.object.empty.or(P.number), () => 'matched')
+      .otherwise(() => 'nope' as const);
+    expect(result1).toBe('matched');
+
+    const result2 = match<unknown>(42)
+      .with(P.object.empty.or(P.number), () => 'matched')
+      .otherwise(() => 'nope' as const);
+    expect(result2).toBe('matched');
+  });
+
+  it('should support .select() on P.object.empty', () => {
+    // Just verify it compiles and matches
+    const result = match<unknown>({} as object)
+      .with(P.object.empty.select(), () => 'matched' as const)
+      .otherwise(() => 'nope' as const);
+    expect(result).toBe('matched');
+  });
+
+  it('should match empty objects with Symbol keys only', () => {
+    const sym = Symbol('k');
+    const obj: Record<symbol, number> = {};
+    obj[sym] = 1;
+    // Object.keys() only returns enumerable string-keyed properties
+    expect(Object.keys(obj).length).toBe(0);
+    expect(isMatching(P.object.empty, obj as unknown)).toBe(true);
+  });
+
+  it('P.object and P.object.empty should be accessible via the P namespace', () => {
+    // Verify they are exported on the P namespace as matchable patterns
+    expect(P.object).toBeDefined();
+    expect(typeof (P.object as any)[Symbol.for('@ts-pattern/matcher')]).toBe('function');
+    expect((P.object as any).empty).toBeDefined();
+    expect(typeof (P.object as any).empty).toBe('object');
+    expect((P.object.empty as any)).toEqual(P.object.empty);
+  });
+
+  it('P.object.empty should be independently usable', () => {
+    // Verify P.object.empty works on its own without going through P.object
+    type Input = unknown;
+    const fn = (input: Input) =>
+      match<Input, string>(input)
+        .with(P.object.empty, () => 'matched' as const)
+        .otherwise(() => 'nope' as const);
+
+    expect(fn({} as object)).toBe('matched');
+    expect(fn([] as unknown)).toBe('nope');
+  });
+});
