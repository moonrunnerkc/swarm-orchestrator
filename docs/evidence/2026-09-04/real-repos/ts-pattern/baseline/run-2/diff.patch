+describe('P.object', () => {
+  it('should match plain objects, arrays, Maps and Sets via isMatching', () => {
+    const o1: unknown = {};
+    expect(isMatching(P.object, o1)).toBe(true);
+    const o2: unknown = { a: 1 };
+    expect(isMatching(P.object, o2)).toBe(true);
+    const o3: unknown = [] as unknown[];
+    expect(isMatching(P.object, o3)).toBe(true);
+    const o4: unknown = [1, 2];
+    expect(isMatching(P.object, o4)).toBe(true);
+    const m1: unknown = new Map();
+    expect(isMatching(P.object, m1)).toBe(true);
+    const m2: unknown = new Map([['a', 1]]);
+    expect(isMatching(P.object, m2)).toBe(true);
+    const s1: unknown = new Set();
+    expect(isMatching(P.object, s1)).toBe(true);
+    const s2: unknown = new Set([1]);
+    expect(isMatching(P.object, s2)).toBe(true);
+    const oc: unknown = Object.create(null);
+    expect(isMatching(P.object, oc)).toBe(true);
+  });
+
+  it('should not match null, undefined or primitives via isMatching', () => {
+    expect(isMatching(P.object, null as unknown)).toBe(false);
+    expect(isMatching(P.object, undefined as unknown)).toBe(false);
+    expect(isMatching(P.object, 'str' as unknown)).toBe(false);
+    expect(isMatching(P.object, 42 as unknown)).toBe(false);
+    expect(isMatching(P.object, true as unknown)).toBe(false);
+    expect(isMatching(P.object, Symbol('s') as unknown)).toBe(false);
+  });
+
+  it('should narrow type to object in match().with()', () => {
+    const result = match<unknown | string>([1, 2, 3])
+      .with(P.object, (val) => {
+        return 'matched' as const;
+      })
+      .otherwise(() => 'nope' as const);
+    expect(result).toBe('matched');
+  });
+
+  it('should match objects with unknown input', () => {
+    type Input = unknown;
+    const fn = (input: Input) =>
+      match<Input, string>(input)
+        .with(P.object, () => 'object')
+        .otherwise(() => 'other');
+
+    expect(fn({} as object)).toBe('object');
+    expect(fn([] as unknown)).toBe('object');
+    expect(fn(new Map() as unknown)).toBe('object');
+    expect(fn(null)).toBe('other');
+    expect(fn(undefined)).toBe('other');
+  });
+
+  it('should support .optional()', () => {
+    const result1 = match<{ x?: object }>({})
+      .with({ x: P.object.optional() }, () => 'present or missing')
+      .otherwise(() => 'unexpected' as const);
+    expect(result1).toBe('present or missing');
+
+    const result2 = match<{ x: object | undefined }>({ x: undefined })
+      .with({ x: P.object.optional() }, () => 'present or missing')
+      .otherwise(() => 'unexpected' as const);
+    expect(result2).toBe('present or missing');
+
+    const result3 = match<{ x: object }>({ x: [1, 2] })
+      .with({ x: P.object.optional() }, () => 'present')
+      .otherwise(() => 'unexpected' as const);
+    expect(result3).toBe('present');
+  });
+
+  it('should support .and()', () => {
+    const result = match<unknown>([1, 2])
+      .with(P.object.and(P.array()), () => {
+        return 'matched' as const;
+      })
+      .otherwise(() => 'nope' as const);
+    expect(result).toBe('matched');
+
+    const result2 = match<unknown>('hello')
+      .with(P.object.and(P.array()), () => 'unexpected' as const)
+      .otherwise(() => 'nope' as const);
+    expect(result2).toBe('nope');
+  });
+
+  it('should support .or()', () => {
+    const result = match<unknown>(42)
+      .with(P.object.or(P.number), () => {
+        return 'matched' as const;
+      })
+      .otherwise(() => 'nope' as const);
+    expect(result).toBe('matched');
+
+    const result2 = match<unknown>({} as object)
+      .with(P.object.or(P.number), () => {
+        return 'matched' as const;
+      })
+      .otherwise(() => 'nope' as const);
+    expect(result2).toBe('matched');
+  });
+
+  it('should support .select()', () => {
+    // Anonymous select test - just verify it doesn't throw
+    const result = match([1, 2, 3])
+      .with(P.object.select(), () => 'matched' as const)
+      .otherwise(() => 'nope' as const);
+    expect(result).toBe('matched');
+  });
+
+  it('should be chainable with P.object.empty', () => {
+    type Input = unknown;
