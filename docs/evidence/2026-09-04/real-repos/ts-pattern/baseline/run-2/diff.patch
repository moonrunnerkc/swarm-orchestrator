+    expect(fn(undefined)).toBe('other');
+    expect(fn({ a: 1 } as object)).toBe('other');
+    expect(fn([1])).toBe('other');
+    expect(fn(new Map([['k', 'v']]))).toBe('other');
+  });
+
+  it('should support isMatching with P.object.empty', () => {
+    expect(isMatching(P.object.empty, {} as unknown)).toBe(true);
+    expect(isMatching(P.object.empty, Object.create(null))).toBe(true);
+    expect(isMatching(P.object.empty, [] as unknown)).toBe(false);
+    expect(isMatching(P.object.empty, [1] as unknown)).toBe(false);
+    expect(isMatching(P.object.empty, new Map() as unknown)).toBe(false);
