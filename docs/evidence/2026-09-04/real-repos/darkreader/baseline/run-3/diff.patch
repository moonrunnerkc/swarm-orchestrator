@@ -0,0 +1,43 @@
+import {chunk} from '../../../src/utils/array';
+
+test('Chunk with normal array', () => {
+    expect(chunk([1, 2, 3, 4, 5], 2)).toEqual([[1, 2], [3, 4], [5]]);
+});
+
+test('Chunk evenly divides', () => {
+    expect(chunk([1, 2, 3, 4], 2)).toEqual([[1, 2], [3, 4]]);
+});
+
+test('Chunk with size equal to array length', () => {
+    expect(chunk([1, 2, 3], 3)).toEqual([[1, 2, 3]]);
+});
+
+test('Chunk with size larger than array', () => {
+    expect(chunk([1, 2, 3], 5)).toEqual([[1, 2, 3]]);
+});
+
+test('Chunk with size 1', () => {
+    expect(chunk([1, 2, 3], 1)).toEqual([[1], [2], [3]]);
+});
+
+test('Chunk empty array', () => {
+    expect(chunk([], 3)).toEqual([]);
+});
+
+test('Chunk does not mutate input', () => {
+    const original = [1, 2, 3, 4];
+    const copy = [...original];
+    chunk(original, 2);
+    expect(original).toEqual(copy);
+});
+
+test('Chunk returns new arrays (not shared refs)', () => {
+    const result = chunk([1, 2, 3], 2);
+    expect(result[0]).not.toBe(result[1]);
+});
+
+const invalidSizes = [0, -1, 1.5, NaN, Infinity, -Infinity];
+
+test.each(invalidSizes)('Chunk throws RangeError for size %p', (size) => {
+    expect(() => chunk([1, 2], size)).toThrow(RangeError);
+});
