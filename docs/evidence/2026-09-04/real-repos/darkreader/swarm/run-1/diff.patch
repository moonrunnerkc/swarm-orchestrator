+import {chunk} from '../../../src/utils/array';
+
+describe('chunk', () => {
+    it('splits an array in half when size = 2 and length = 4', () => {
+        const input = [1, 2, 3, 4];
+        expect(chunk(input, 2)).toEqual([[1, 2], [3, 4]]);
+    });
+
+    it('puts remainder in last group when size does not divide length evenly', () => {
+        expect(chunk([1, 2, 3, 4, 5], 2)).toEqual([[1, 2], [3, 4], [5]]);
+    });
+
+    it('returns empty array for empty input', () => {
+        expect(chunk([], 3)).toEqual([]);
+    });
+
+    it.each([0, -1, -5, NaN, Infinity, -Infinity])(
+        'throws RangeError for size = %p',
+        (size) => {
+            expect(() => chunk([1, 2], size as unknown as number))
+                .toThrow(RangeError);
+        },
+    );
+
+    it('throws RangeError for non-integer decimal size 1.5', () => {
+        expect(() => chunk([1, 2], 1.5)).toThrow(RangeError);
+    });
+
+    it('does not mutate the input array', () => {
+        const original = [1, 2, 3];
+        const copy = [...original];
+        chunk(original, 2);
+        expect(original).toEqual(copy);
+    });
+
+    it('handles size >= length', () => {
+        expect(chunk([1, 2, 3], 5)).toEqual([[1, 2, 3]]);
+        expect(chunk([1, 2, 3], 3)).toEqual([[1, 2, 3]]);
+    });
+
+    it('handles size = 1', () => {
+        expect(chunk([1, 2, 3], 1)).toEqual([[1], [2], [3]]);
+    });
+});
