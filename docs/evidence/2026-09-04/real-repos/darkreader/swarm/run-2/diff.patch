+import {chunk} from '../../../src/utils/array';
+
+describe('chunk', () => {
+    it('splits an array into groups of the given size', () => {
+        expect(chunk([1, 2, 3, 4, 5], 2)).toEqual([[1, 2], [3, 4], [5]]);
+    });
+
+    it('returns an empty array for an empty input', () => {
+        expect(chunk([], 3)).toEqual([]);
+    });
+
+    it('handles arrays smaller than size', () => {
+        expect(chunk([1, 2], 5)).toEqual([[1, 2]]);
+    });
+
+    it('returns single-element groups when size is 1', () => {
+        expect(chunk([1, 2, 3], 1)).toEqual([[1], [2], [3]]);
+    });
+
+    it('handles exact division evenly', () => {
+        expect(chunk([1, 2, 3, 4], 2)).toEqual([[1, 2], [3, 4]]);
+    });
+
+    it('preserves original order', () => {
+        expect(chunk(['a', 'b', 'c'], 2)).toEqual([
+            ['a', 'b'],
+            ['c'],
+        ]);
+    });
+
+    it('does not mutate the input array', () => {
+        const arr = [1, 2, 3, 4];
+        chunk(arr, 2);
+        expect(arr).toEqual([1, 2, 3, 4]);
+    });
+
+    describe('validation', () => {
+        it('throws RangeError for size 0', () => {
+            expect(() => chunk([1], 0)).toThrow(RangeError);
+        });
+
+        it('throwing message names the size for 0', () => {
+            expect(() => chunk([1], 0)).toThrow(/Invalid size: 0/);
+        });
+
+        it('throws RangeError for negative size', () => {
+            expect(() => chunk([1], -1)).toThrow(RangeError);
+        });
+
+        it('throwing message names the size for -1', () => {
+            expect(() => chunk([1], -1)).toThrow(/Invalid size: -1/);
+        });
+
+        it('throws RangeError for non-integer (float)', () => {
+            expect(() => chunk([1], 1.5)).toThrow(RangeError);
+        });
+
+        it('throwing message names the value for NaN', () => {
+            expect(() => chunk([1], NaN)).toThrow(/Invalid size: NaN/);
+        });
+
+        it('throws RangeError for Infinity', () => {
+            expect(() => chunk([1], Infinity)).toThrow(RangeError);
+        });
+
+        it('throwing message names Infinity', () => {
+            expect(() => chunk([1], Infinity)).toThrow(/Invalid size: Infinity/);
+        });
+
+        it('throws RangeError for negative integer', () => {
+            expect(() => chunk([1], -5)).toThrow(RangeError);
+        });
+    });
+
+    describe('general size validation', () => {
+        const invalidSizes = [0, -1, 1.5, NaN, Infinity, Number.NEGATIVE_INFINITY];
+
+        for (const s of invalidSizes) {
+            it(`throws RangeError when size is ${s}`, () => {
+                expect(() => chunk([1], s)).toThrow(RangeError);
+            });
+        }
+    });
+});
