diff --git a/tests/options.getset.test.js b/tests/options.getset.test.js
index d283ab8..a6bbaba 100644
--- a/tests/options.getset.test.js
+++ b/tests/options.getset.test.js
@@ -66,3 +66,55 @@ test('when setOptionValue then clears previous source', () => {
   program.setOptionValue('foo', 'bar');
   expect(program.getOptionValueSource('foo')).toBeUndefined();
 });
+
+test('when option source set on program then source returned by getOptionValueSourceWithGlobals in sub', () => {
+  const program = new commander.Command();
+  let source;
+  program
+    .option('-g, --global <value>')
+    .command('sub')
+    .action((options, cmd) => {
+      source = cmd.getOptionValueSourceWithGlobals('global');
+    });
+
+  program.parse(['-g', 'GGG', 'sub'], { from: 'user' });
+  expect(source).toBe('cli');
+});
+
+test('when option source set on sub then source returned by getOptionValueSourceWithGlobals in sub', () => {
+  const program = new commander.Command();
+  let source;
+  program
+    .command('sub')
+    .option('-l, --local <value)')
+    .action((options, cmd) => {
+      source = cmd.getOptionValueSourceWithGlobals('local');
+    });
+
+  program.parse(['sub', '-l', 'LLL'], { from: 'user' });
+  expect(source).toBe('cli');
+});
+
+test('when same named option in sub and program then getOptionValueSourceWithGlobals returns local source', () => {
+  const program = new commander.Command();
+  let source;
+  program
+    .option('-c, --common <value>')
+    .enablePositionalOptions();
+  program
+    .command('sub')
+    .option('-c, --common <value)')
+    .action((options, cmd) => {
+      source = cmd.getOptionValueSourceWithGlobals('common');
+    });
+
+  program.parse(['-c', 'GGG', 'sub', '-c', 'LLL'], { from: 'user' });
+  expect(source).toBe('cli');
+});
+
+test('when option not set then getOptionValueSourceWithGlobals returns undefined', () => {
+  const program = new commander.Command();
+  program
+    .option('-g, --global <value>');
+  expect(program.getOptionValueSourceWithGlobals('global')).toBeUndefined();
+});
