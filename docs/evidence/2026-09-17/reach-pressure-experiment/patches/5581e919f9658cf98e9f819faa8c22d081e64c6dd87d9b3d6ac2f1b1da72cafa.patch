+  /**
+   * Get source of option value, including global options.
+   * Expected values are default | config | env | cli | implied
+   *
+   * @param {string} key
+   * @return {string}
+   */
+
+  getOptionValueSourceWithGlobals(key) {
+    return getCommandAndParents(this).reduce(
+      (source, cmd) => cmd.getOptionValueSource(key) ?? source,
+      undefined
+    );
+  }
+
