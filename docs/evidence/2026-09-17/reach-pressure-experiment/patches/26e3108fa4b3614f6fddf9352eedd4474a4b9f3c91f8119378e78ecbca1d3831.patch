diff --git a/probe-tmp.js b/probe-tmp.js
new file mode 100644
index 0000000..602f92e
--- /dev/null
+++ b/probe-tmp.js
@@ -0,0 +1,14 @@
+const dayjs = require('./src/index.js')
+const timezone = require('./src/plugin/timezone/index.js')
+const utc = require('./src/plugin/utc/index.js')
+dayjs.extend(utc)
+dayjs.extend(timezone)
+const NY = 'America/New_York'
+const invalid = dayjs('invalid')
+console.log('proto.tz invalid:', invalid.tz(NY).isValid())
+console.log('d.tz invalid string:', dayjs.tz('invalid', NY).isValid())
+console.log('d.tz invalid date:', dayjs.tz(new Date(NaN), NY).isValid())
+console.log('d.tz invalid dayjs:', dayjs.tz(dayjs('invalid'), NY).isValid())
+console.log('d.tz invalid number:', dayjs.tz(NaN, NY).isValid())
+console.log('d.tz invalid string no tz:', dayjs.tz('invalid').isValid())
+console.log('d.tz valid:', dayjs.tz('2014-06-01 12:00', NY).format())
