diff --git a/tests/command.summary.test.js b/tests/command.summary.test.js
new file mode 100644
index 0000000..0b95ac8
--- /dev/null
+++ b/tests/command.summary.test.js
@@ -0,0 +1,44 @@
+const commander = require('../');
+
+test('when set summary then get summary', () => {
+  const program = new commander.Command();
+  const summary = 'abcdef';
+  program.summary(summary);
+  expect(program.summary()).toEqual(summary);
+});
+
+test('when no summary then empty string', () => {
+  const program = new commander.Command();
+  expect(program.summary()).toEqual('');
+});
+
+test('when set summary then used in subcommand listing', () => {
+  const program = new commander.Command();
+  program
+    .command('sub')
+    .description('long description')
+    .summary('short summary');
+  const commandHelp = program.helpInformation();
+  expect(commandHelp).toMatch(/Commands:\n +sub +short summary\n/);
+  expect(commandHelp).not.toMatch(/long description/);
+});
+
+test('when no summary then description used in subcommand listing', () => {
+  const program = new commander.Command();
+  program
+    .command('sub')
+    .description('long description');
+  const commandHelp = program.helpInformation();
+  expect(commandHelp).toMatch(/Commands:\n +sub +long description\n/);
+});
+
+test('when set summary then description still used in subcommand help', () => {
+  const program = new commander.Command();
+  const sub = program
+    .command('sub')
+    .description('long description')
+    .summary('short summary');
+  const subHelp = sub.helpInformation();
+  expect(subHelp).toMatch(/long description/);
+  expect(subHelp).not.toMatch(/short summary/);
+});
