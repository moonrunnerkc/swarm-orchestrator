diff --git a/tests/options.getset.test.js b/tests/options.getset.test.js
index adb15e6..a59a001 100644
--- a/tests/options.getset.test.js
+++ b/tests/options.getset.test.js
@@ -21,4 +21,51 @@ describe.each([true, false])('storeOptionsAsProperties is %s', (storeOptionsAsPr
       .setOptionValue('cheese', cheeseType);
     expect(program.opts().cheese).toBe(cheeseType);
   });
+
+  test('when setOptionValueWithSource then value returned by getOptionValue', () => {
+    const program = new commander.Command();
+    const cheeseType = 'blue';
+    program
+      .storeOptionsAsProperties(storeOptionsAsProperties)
+      .option('--cheese [type]', 'cheese type')
+      .setOptionValueWithSource('cheese', cheeseType, 'config');
+    expect(program.getOptionValue('cheese')).toBe(cheeseType);
+  });
+
+  test('when setOptionValueWithSource then source returned by getOptionValueSource', () => {
+    const program = new commander.Command();
+    const cheeseType = 'blue';
+    program
+      .storeOptionsAsProperties(storeOptionsAsProperties)
+      .option('--cheese [type]', 'cheese type')
+      .setOptionValueWithSource('cheese', cheeseType, 'config');
+    expect(program.getOptionValueSource('cheese')).toBe('config');
+  });
+
+  test('when option specified on CLI then source returned by getOptionValueSource is cli', () => {
+    const program = new commander.Command();
+    program
+      .storeOptionsAsProperties(storeOptionsAsProperties)
+      .option('--cheese [type]', 'cheese type');
+    program.parse(['node', 'test', '--cheese', 'blue']);
+    expect(program.getOptionValueSource('cheese')).toBe('cli');
+  });
+
+  test('when option has default then source returned by getOptionValueSource is default', () => {
+    const program = new commander.Command();
+    program
+      .storeOptionsAsProperties(storeOptionsAsProperties)
+      .option('--cheese [type]', 'cheese type', 'default');
+    program.parse(['node', 'test']);
+    expect(program.getOptionValueSource('cheese')).toBe('default');
+  });
+
+  test('when option has no value then source returned by getOptionValueSource is undefined', () => {
+    const program = new commander.Command();
+    program
+      .storeOptionsAsProperties(storeOptionsAsProperties)
+      .option('--cheese [type]', 'cheese type');
+    program.parse(['node', 'test']);
+    expect(program.getOptionValueSource('cheese')).toBeUndefined();
+  });
 });
