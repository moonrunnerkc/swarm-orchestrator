@@ -43,6 +43,40 @@ test('when commands added using .addCommand and .command then internals similar'
   }
 });
 
+test('when copyInheritedSettings then settings copied', () => {
+  const program = new commander.Command();
+  program
+    .helpOption('-h, --help', 'custom help description')
+    .exitOverride()
+    .storeOptionsAsProperties(false)
+    .combineFlagAndOptionalValue(false)
+    .allowExcessArguments(false)
+    .enablePositionalOptions()
+    .showHelpAfterError('custom message');
+
+  const sub = new commander.Command('sub');
+  sub.copyInheritedSettings(program);
+
+  expect(sub._hasHelpOption).toBe(true);
+  expect(sub._helpFlags).toBe('-h, --help');
+  expect(sub._helpDescription).toBe('custom help description');
+  expect(sub._helpShortFlag).toBe('-h');
+  expect(sub._helpLongFlag).toBe('--help');
+  expect(sub._exitCallback).toBe(program._exitCallback);
+  expect(sub._storeOptionsAsProperties).toBe(false);
+  expect(sub._combineFlagAndOptionalValue).toBe(false);
+  expect(sub._allowExcessArguments).toBe(false);
+  expect(sub._enablePositionalOptions).toBe(true);
+  expect(sub._showHelpAfterError).toBe('custom message');
+  expect(sub._outputConfiguration).toBe(program._outputConfiguration);
+});
+
+test('when copyInheritedSettings then returns this for chaining', () => {
+  const program = new commander.Command();
+  const sub = new commander.Command('sub');
+  expect(sub.copyInheritedSettings(program)).toBe(sub);
+});
+
