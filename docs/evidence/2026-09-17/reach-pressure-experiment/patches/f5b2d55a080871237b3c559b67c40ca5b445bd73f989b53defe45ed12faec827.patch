+describe('preSubcommand hooks', () => {
+  test('when hook preSubcommand then hook called before subcommand action', () => {
+    const calls = [];
+    const program = new commander.Command();
+    program
+      .hook('preSubcommand', () => calls.push('before'))
+      .command('sub')
+      .action(() => calls.push('action'));
+    program.parse(['sub'], { from: 'user' });
+    expect(calls).toEqual(['before', 'action']);
+  });
+
+  test('when hook preSubcommand twice then hooks called FIFO', () => {
+    const calls = [];
+    const program = new commander.Command();
+    program
+      .hook('preSubcommand', () => calls.push('1'))
+      .hook('preSubcommand', () => calls.push('2'))
+      .command('sub')
+      .action(() => calls.push('action'));
+    program.parse(['sub'], { from: 'user' });
+    expect(calls).toEqual(['1', '2', 'action']);
+  });
+
+  test('when hook preSubcommand at program and sub then hooks called program then sub', () => {
+    const calls = [];
+    const program = new commander.Command();
+    program
+      .hook('preSubcommand', () => calls.push('program'));
+    program.command('sub')
+      .hook('preSubcommand', () => calls.push('sub'))
+      .action(() => calls.push('action'));
+    program.parse(['sub'], { from: 'user' });
+    expect(calls).toEqual(['program', 'sub', 'action']);
+  });
+
+  test('when hook preSubcommand then hook called before preAction', () => {
+    const calls = [];
+    const program = new commander.Command();
+    program
+      .hook('preSubcommand', () => calls.push('preSubcommand'))
+      .command('sub')
+      .hook('preAction', () => calls.push('preAction'))
+      .action(() => calls.push('action'));
+    program.parse(['sub'], { from: 'user' });
+    expect(calls).toEqual(['preSubcommand', 'preAction', 'action']);
+  });
+
+  test('when hook on program and call sub then passed program/sub', () => {
+    const hook = jest.fn();
+    const program = new commander.Command();
+    program
+      .hook('preSubcommand', hook);
+    const sub = program.command('sub')
+      .action(() => {});
+    program.parse(['sub'], { from: 'user' });
+    expect(hook).toHaveBeenCalledWith(program, sub);
+  });
+
+  test('when hook on sub and call sub then passed sub/sub', () => {
+    const hook = jest.fn();
+    const program = new commander.Command();
+    const sub = program.command('sub')
+      .hook('preSubcommand', hook)
+      .action(() => {});
+    program.parse(['sub'], { from: 'user' });
+    expect(hook).toHaveBeenCalledWith(sub, sub);
+  });
+
+  test('when hook program on preSubcommand then thisCommand has options set', () => {
+    expect.assertions(1);
+    const program = new commander.Command();
+    program
+      .option('--debug')
+      .hook('preSubcommand', (thisCommand) => {
+        expect(thisCommand.opts().debug).toEqual(true);
+      });
+    program.command('sub')
+      .action(() => {});
+    program.parse(['--debug', 'sub'], { from: 'user' });
+  });
+
+  test('when hook program on preSubcommand and call sub then thisCommand has program args set', () => {
+    expect.assertions(1);
+    const program = new commander.Command();
+    program
+      .hook('preSubcommand', (thisCommand) => {
+        expect(thisCommand.args).toEqual(['sub', 'value']);
+      });
+    program.command('sub')
+      .argument('[arg]')
+      .action(() => {});
+    program.parse(['sub', 'value'], { from: 'user' });
+  });
+
+  test('when async preSubcommand then async from preSubcommand', async() => {
+    const calls = [];
+    const program = new commander.Command();
+    program
+      .hook('preSubcommand', async() => {
+        await 0;
+        calls.push('before');
+      })
+      .command('sub')
+      .action(() => calls.push('action'));
+    const result = program.parseAsync(['sub'], { from: 'user' });
+    expect(calls).toEqual([]);
+    await result;
+    expect(calls).toEqual(['before', 'action']);
+  });
+});
+
