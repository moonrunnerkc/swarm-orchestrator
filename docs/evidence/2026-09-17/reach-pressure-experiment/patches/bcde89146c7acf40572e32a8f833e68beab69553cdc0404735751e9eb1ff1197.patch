diff --git a/tests/command.optsWithGlobals.test.js b/tests/command.optsWithGlobals.test.js
new file mode 100644
index 0000000..e8b2829
--- /dev/null
+++ b/tests/command.optsWithGlobals.test.js
@@ -0,0 +1,54 @@
+const commander = require('../');
+
+test('when no globals then same as opts', () => {
+  const program = new commander.Command();
+  program
+    .option('-f, --foo', 'add some foo')
+    .option('-b, --bar', 'add some bar');
+  program.parse(['node', 'test', '--foo']);
+  expect(program.optsWithGlobals()).toEqual(program.opts());
+});
+
+test('when globals then merged with local taking precedence', () => {
+  const program = new commander.Command();
+  program
+    .option('-f, --foo', 'add some foo')
+    .option('-b, --bar', 'add some bar');
+  const sub = program.command('sub');
+  sub
+    .option('-b, --bar <bar>', 'add some bar')
+    .option('-c, --cheese <cheese>', 'add some cheese');
+  program.parse(['node', 'test', '--foo', 'sub', '--bar', 'sub', '--cheese', 'sub']);
+  expect(sub.optsWithGlobals()).toEqual({ foo: true, bar: 'sub', cheese: 'sub' });
+});
+
+test('when globals then merged with local taking precedence (nested)', () => {
+  const program = new commander.Command();
+  program
+    .option('-f, --foo', 'add some foo')
+    .option('-b, --bar', 'add some bar');
+  const sub = program.command('sub');
+  sub
+    .option('-b, --bar <bar>', 'add some bar')
+    .option('-c, --cheese <cheese>', 'add some cheese');
+  const subsub = sub.command('subsub');
+  subsub
+    .option('-c, --cheese <cheese>', 'add some cheese')
+    .option('-d, --debug', 'add some debug');
+  program.parse(['node', 'test', '--foo', 'sub', '--bar', 'sub', '--cheese', 'sub', 'subsub', '--cheese', 'subsub', '--debug']);
+  expect(subsub.optsWithGlobals()).toEqual({ foo: true, bar: 'sub', cheese: 'subsub', debug: true });
+});
+
+test('when globals then merged with local taking precedence (action handler)', () => {
+  const program = new commander.Command();
+  program
+    .option('-f, --foo', 'add some foo')
+    .option('-b, --bar', 'add some bar');
+  const sub = program.command('sub');
+  sub
+    .option('-b, --bar <bar>', 'add some bar')
+    .action(function() {
+      expect(this.optsWithGlobals()).toEqual({ foo: true, bar: 'sub' });
+    });
+  program.parse(['node', 'test', '--foo', 'sub', '--bar', 'sub']);
+});
