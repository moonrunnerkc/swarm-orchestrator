# Coding conventions proposed from 3 file(s). Nothing here is in effect until you
# approve it:  swarm init --approve <this file> [--global]
# Edit it first: delete a line to leave a rule out, or change a value to another one listed.
# A rule in effect is checked on the files a run adds or changes.

version = "swarm.conventions/v1"
# Preferences nothing can measure (how much to comment, how to phrase an error). The model
# reads them; nothing checks them and no report calls them proven.
guidance = []

[rules]
"exports" = "named"  # inferred: 5 of 5 site(s) in 3 file(s). One of: named, default
"function-names" = "camelCase"  # tentative: 2 of 2 site(s) in 3 file(s). One of: camelCase, snake_case
"variable-names" = "camelCase"  # inferred: 17 of 17 site(s) in 3 file(s). One of: camelCase, snake_case
"type-names" = "PascalCase"  # inferred: 3 of 3 site(s) in 3 file(s). One of: PascalCase
"file-names" = "kebab-case"  # inferred: 3 of 3 site(s) in 3 file(s). One of: kebab-case, camelCase, snake_case, PascalCase
"explicit-any" = "forbidden"  # inferred: 3 of 3 site(s) in 3 file(s). One of: forbidden
"exported-return-types" = "explicit"  # tentative: 1 of 1 site(s) in 3 file(s). One of: explicit
"exported-docs" = "documented"  # inferred: 5 of 5 site(s) in 3 file(s). One of: documented

