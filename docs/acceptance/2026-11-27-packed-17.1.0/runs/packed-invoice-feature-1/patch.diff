diff --git a/src/invoices.ts b/src/invoices.ts
index cabcab3..7530896 100644
--- a/src/invoices.ts
+++ b/src/invoices.ts
@@ -7,9 +7,29 @@ export interface InvoiceSummary {
   readonly totalCents: number;
 }
 
+/** An invoice as the download endpoint serves it. */
+export interface InvoiceDownload {
+  readonly number: string;
+  readonly totalCents: number;
+  readonly lines: readonly string[];
+}
+
 /** The invoices a user owns, in the order they were issued. */
 export function listInvoices(user: User): InvoiceSummary[] {
   return invoices
     .filter((invoice) => invoice.ownerId === user.id)
     .map(({ id, number, totalCents }) => ({ id, number, totalCents }));
 }
+
+/** The invoice with the given id, if it is owned by the user. */
+export function getInvoiceForDownload(user: User, id: string): InvoiceDownload | null {
+  const invoice = invoices.find((invoice) => invoice.id === id);
+  if (invoice === undefined || invoice.ownerId !== user.id) {
+    return null;
+  }
+  return {
+    number: invoice.number,
+    totalCents: invoice.totalCents,
+    lines: invoice.lines,
+  };
+}
