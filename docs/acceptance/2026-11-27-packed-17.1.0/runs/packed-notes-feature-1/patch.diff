 ];
 
 /** Starts the notes service on a port; 0 takes any free one. */
diff --git a/service/store.ts b/service/store.ts
index 8f0d6c5..845e975 100644
--- a/service/store.ts
+++ b/service/store.ts
@@ -22,3 +22,11 @@ export const notes: Note[] = [
   { slug: "n-1", authorId: "lin", text: "first" },
   { slug: "n-2", authorId: "omar", text: "second" },
 ];
+
+/** Deletes a note by slug and authorId; returns true if deleted, false otherwise. */
+export function deleteNote(slug: string, authorId: string): boolean {
+  const index = notes.findIndex((note) => note.slug === slug && note.authorId === authorId);
+  if (index === -1) return false;
+  notes.splice(index, 1);
+  return true;
+}
