@@ -1,5 +1,5 @@
 import { createServer, type Server } from "node:http";
-import { accounts, notes } from "./store.ts";
+import { accounts, notes, deleteNote } from "./store.ts";
 
 interface Route {
   readonly method: string;
@@ -13,6 +13,15 @@ const routes: readonly Route[] = [
     pattern: /^\/notes$/,
     run: (handle) => ({ status: 200, body: notes.filter((note) => note.authorId === handle) }),
   },
+  {
+    method: "DELETE",
+    pattern: /^\/notes\/([^\/]+)$/,
+    run: (handle, match) => {
+      const slug = match[1];
+      const deleted = deleteNote(slug, handle);
+      return { status: deleted ? 204 : 404, body: deleted ? undefined : { error: "not found" } };
