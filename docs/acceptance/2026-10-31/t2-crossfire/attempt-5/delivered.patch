diff --git a/test/config.test.ts b/test/config.test.ts
index 3003704..ca1bef7 100644
--- a/test/config.test.ts
+++ b/test/config.test.ts
@@ -266,3 +266,40 @@ describe("loadRunConfig", () => {
     expect(() => loadRunConfig(writeConfig(raw))).toThrow(ConfigError);
   });
 });
+
+describe("semgrep ruleset accepts arrays", () => {
+  test("accepts a string ruleset (existing behavior)", () => {
+    const raw = minimalConfig();
+    (raw.detectors as Record<string, Record<string, unknown>>).semgrep!.ruleset = "p/security-audit";
+
+    const config = loadRunConfig(writeConfig(raw));
+
+    expect(config.detectors.semgrep.ruleset).toBe("p/security-audit");
+  });
+
+  test("accepts an array of rulesets", () => {
+    const raw = minimalConfig();
+    (raw.detectors as Record<string, Record<string, unknown>>).semgrep!.ruleset = [
+      "p/security-audit",
+      "p/secrets",
+    ];
+
+    const config = loadRunConfig(writeConfig(raw));
+
+    expect(config.detectors.semgrep.ruleset).toEqual(["p/security-audit", "p/secrets"]);
+  });
+
+  test("rejects an array with an empty string", () => {
+    const raw = minimalConfig();
+    (raw.detectors as Record<string, Record<string, unknown>>).semgrep!.ruleset = ["", "p/security-audit"];
+
+    expect(() => loadRunConfig(writeConfig(raw))).toThrow(/detectors\.semgrep\.ruleset/);
+  });
+
+  test("rejects an empty array", () => {
+    const raw = minimalConfig();
+    (raw.detectors as Record<string, Record<string, unknown>>).semgrep!.ruleset = [];
+
+    expect(() => loadRunConfig(writeConfig(raw))).toThrow(/detectors\.semgrep\.ruleset/);
+  });
+});
diff --git a/test/scanner.test.ts b/test/scanner.test.ts
