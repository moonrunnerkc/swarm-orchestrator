   });
 });
+
+describe("semgrep ruleset as array", () => {
+  test("passes one --config per ruleset entry", () => {
+    const findings = normalizeSemgrepOutput(
+      {
+        results: [
+          {
+            check_id: "c.lang.security.insecure-use-gets-fn.insecure-use-gets-fn",
+            path: "src/input.c",
+            start: { line: 12 },
+            extra: { message: "gets is unbounded", severity: "WARNING" },
+          },
+        ],
+      },
+      { enabled: true, ruleset: ["p/security-audit", "p/secrets"], timeBudgetMs: 1000 },
+      FIXTURE,
+    );
+
+    expect(findings).toHaveLength(1);
+    expect(findings[0]?.class).toBe("insecure-use-gets-fn");
+  });
+
+  test("reproCommand includes all configs when ruleset is an array", () => {
+    const findings = normalizeSemgrepOutput(
+      {
+        results: [
+          {
+            check_id: "c.lang.security.insecure-use-gets-fn.insecure-use-gets-fn",
+            path: "src/input.c",
+            start: { line: 12 },
+            extra: { message: "gets is unbounded", severity: "WARNING" },
+          },
+        ],
+      },
+      { enabled: true, ruleset: ["p/security-audit", "p/secrets"], timeBudgetMs: 1000 },
+      FIXTURE,
+    );
+
+    expect(findings[0]?.repro_command).toContain("--config 'p/security-audit'");
+    expect(findings[0]?.repro_command).toContain("--config 'p/secrets'");
+  });
+
+  test("reproCommand includes the single config when ruleset is a string", () => {
+    const findings = normalizeSemgrepOutput(
+      {
+        results: [
+          {
+            check_id: "c.lang.security.insecure-use-gets-fn.insecure-use-gets-fn",
+            path: "src/input.c",
+            start: { line: 12 },
+            extra: { message: "gets is unbounded", severity: "WARNING" },
+          },
+        ],
+      },
+      { enabled: true, ruleset: "p/security-audit", timeBudgetMs: 1000 },
+      FIXTURE,
+    );
+
+    expect(findings[0]?.repro_command).toContain("--config 'p/security-audit'");
+  });
+});
