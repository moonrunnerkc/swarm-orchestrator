+    const raw = minimalConfig();
+    (raw.detectors as Record<string, Record<string, unknown>>).semgrep!.ruleset = "p/security-audit";
+
+    const config = loadRunConfig(writeConfig(raw));
+
+    expect(config.detectors.semgrep.ruleset).toBe("p/security-audit");
+  });
+
+  test("accepts an array of rulesets", () => {
+    const raw = minimalConfig();
+    (raw.detectors as Record<string, Record<string, unknown>>).semgrep!.ruleset = [
+      "p/security-audit",
+      "p/secrets",
+    ];
+
+    const config = loadRunConfig(writeConfig(raw));
+
+    expect(config.detectors.semgrep.ruleset).toEqual(["p/security-audit", "p/secrets"]);
+  });
