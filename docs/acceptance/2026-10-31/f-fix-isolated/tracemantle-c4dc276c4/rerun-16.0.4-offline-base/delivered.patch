@@ -0,0 +1,110 @@
+import os
+import pathlib
+import pytest
+from skillcheck.config_loader import find_config, load_config, ConfigError, SkillcheckConfig
+
+def test_find_config_stops_at_git(tmp_path):
+    # Setup: /root/.git/skillcheck.toml (should be found)
+    # /root/dir1/.git/skillcheck.toml (should be found if starting in dir1)
+    # /root/dir1/dir2/skillcheck.toml (should be found)
+    # /root/dir1/dir2/ (starting here, should stop at /root/dir1/.git)
+    
+    root = tmp_path / "root"
+    root.mkdir()
+    (root / ".git").mkdir()
+    (root / "skillcheck.toml").write_text("format = 'text'")
+    
+    dir1 = root / "dir1"
+    dir1.mkdir()
+    (dir1 / ".git").mkdir()
+    (dir1 / "skillcheck.toml").write_text("format = 'dir1'")
+    
+    dir2 = dir1 / "dir2"
+    dir2.mkdir()
+    (dir2 / "skillcheck.toml").write_text("format = 'dir2'")
+    
+    # Start in dir2, should find dir2/skillcheck.toml
+    assert find_config(dir2) == dir2 / "skillcheck.toml"
+    
+    # Start in dir2, but remove dir2/skillcheck.toml, should find dir1/skillcheck.toml
+    (dir2 / "skillcheck.toml").unlink()
+    assert find_config(dir2) == dir1 / "skillcheck.toml"
+    
+    # Start in dir2, remove dir1/skillcheck.toml, should stop at dir1/.git and NOT find root/skillcheck.toml
+    (dir1 / "skillcheck.toml").unlink()
+    assert find_config(dir2) is None
+
+def test_find_config_stops_at_home(tmp_path, monkeypatch):
+    # Mock Path.home()
+    home = tmp_path / "home"
+    home.mkdir()
+    (home / "skillcheck.toml").write_text("format = 'home'")
+    
+    # Create a directory above home
+    above_home = home.parent
+    (above_home / "skillcheck.toml").write_text("format = 'above'")
+    
+    monkeypatch.setattr(pathlib.Path, "home", lambda: home)
+    
+    # Start in a subdir of home
+    subdir = home / "subdir"
+    subdir.mkdir()
+    
+    # Should find home/skillcheck.toml
+    assert find_config(subdir) == home / "skillcheck.toml"
+    
+    # Remove home/skillcheck.toml, should NOT find above_home/skillcheck.toml
+    (home / "skillcheck.toml").unlink()
+    assert find_config(subdir) is None
+
+def test_load_config_type_errors(tmp_path):
+    def create_config(content):
+        p = tmp_path / "skillcheck.toml"
+        p.write_text(content)
+        return p
+
+    # Integer error
+    p = create_config("max-lines = 'nope'")
+    with pytest.raises(ConfigError) as exc:
+        load_config(p)
+    assert "Config key 'max-lines' must be an integer (got 'nope')" in str(exc.value)
+
+    # Boolean error
+    p = create_config("strict-vscode = 'yes'")
+    with pytest.raises(ConfigError) as exc:
+        load_config(p)
+    assert "Config key 'strict-vscode' must be true or false (got 'yes')" in str(exc.value)
+
+    # String error
+    p = create_config("format = 5")
+    with pytest.raises(ConfigError) as exc:
+        load_config(p)
+    assert "Config key 'format' must be a string (got 5)" in str(exc.value)
+
+def test_fallback_parser_comments(tmp_path, monkeypatch):
+    # Force fallback parser by mocking tomllib
+    monkeypatch.setattr("skillcheck.config_loader.tomllib", None)
+    
+    p = tmp_path / "skillcheck.toml"
+    # Test inline comments, including # inside quotes
+    p.write_text(
+        'format = "text" # This is a comment\n'
+        'max-lines = 100 # Another comment\n'
+        'target-agent = "agent #1" # Comment after quoted #\n'
+        'ignore = ["file1.py", "file2.py"] # Array comment\n'
+    )
+    
+    config = load_config(p)
+    assert config.format == "text"
+    assert config.max_lines == 100
+    assert config.target_agent == "agent #1"
+    assert config.ignore == ("file1.py", "file2.py")
+
+def test_fallback_parser_invalid_comment(tmp_path, monkeypatch):
+    monkeypatch.setattr("skillcheck.config_loader.tomllib", None)
+    
+    p = tmp_path / "skillcheck.toml"
+    # Test that it doesn't just split by # blindly
+    p.write_text('target-agent = "agent #1"')
+    config = load_config(p)
+    assert config.target_agent == "agent #1"
