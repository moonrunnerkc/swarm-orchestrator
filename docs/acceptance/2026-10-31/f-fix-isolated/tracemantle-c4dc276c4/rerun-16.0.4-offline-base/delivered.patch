@@ -0,0 +1,52 @@
+import sys
+import pytest
+from pathlib import Path
+from skillcheck.cli import main
+from unittest.mock import patch
+
+def test_cli_prints_config_path_to_stderr(tmp_path, monkeypatch):
+    # Create a dummy config file
+    config_file = tmp_path / "skillcheck.toml"
+    config_file.write_text('format = "text"')
+    
+    # Mock sys.argv to simulate running the CLI with a path that will find the config
+    # We use a simple command that doesn't do much, like --version or just a path
+    monkeypatch.setattr(sys, "argv", ["skillcheck", str(tmp_path)])
+    
+    # Capture stderr
+    with patch("sys.stderr") as mock_stderr:
+        # We might need to mock other things to prevent the CLI from actually 
+        # running a full validation which might fail due to missing files
+        # but _apply_config is called early.
+        # To avoid full execution, we can mock run_validation.
+        with patch("skillcheck.cli.run_validation"):
+            try:
+                main()
+            except SystemExit:
+                pass
+            
+            # Check if the expected message was printed to stderr
+            # Since we used a mock, we check the calls to write/print
+            # But print(..., file=sys.stderr) calls sys.stderr.write
+            
+            # Let's check if any call to write contains the expected string
+            found = False
+            for call in mock_stderr.write.call_args_list:
+                if f"Loaded config from {config_file}" in call[0][0]:
+                    found = True
+                    break
+            assert found, f"Expected 'Loaded config from {config_file}' in stderr"
+
+def test_cli_no_config_no_print(tmp_path, monkeypatch):
+    # No config file created
+    monkeypatch.setattr(sys, "argv", ["skillcheck", str(tmp_path)])
+    
+    with patch("sys.stderr") as mock_stderr:
+        with patch("skillcheck.cli.run_validation"):
+            try:
+                main()
+            except SystemExit:
+                pass
+            
+            for call in mock_stderr.write.call_args_list:
+                assert "Loaded config from" not in call[0][0]
