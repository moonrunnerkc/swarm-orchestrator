diff --git a/tests/skillcheck/test_config_loader.py b/tests/skillcheck/test_config_loader.py
new file mode 100644
index 0000000..f850a51
--- /dev/null
+++ b/tests/skillcheck/test_config_loader.py
@@ -0,0 +1,62 @@
+import os
+import pathlib
+import pytest
+from skillcheck.config_loader import load_config, find_config, ConfigError, SkillcheckConfig
+
+def test_find_config_stops_at_git_v2(tmp_path):
+    # /tmp/above/skillcheck.toml
+    # /tmp/above/root/.git
+    # /tmp/above/root/subdir/
+    
+    above = tmp_path / "above"
+    above.mkdir()
+    (above / "skillcheck.toml").write_text("format = 'above'")
+    
+    root = above / "root"
+    root.mkdir()
+    (root / ".git").mkdir()
+    
+    subdir = root / "subdir"
+    subdir.mkdir()
+    
+    # Should NOT find the one in 'above'
+    assert find_config(subdir) is None
+
+def test_load_config_type_errors(tmp_path):
+    conf = tmp_path / "skillcheck.toml"
+    
+    # Integer error
+    conf.write_text("max-lines = 'nope'")
+    with pytest.raises(ConfigError) as excinfo:
+        load_config(conf)
+    assert "Config key 'max-lines' must be an integer (got 'nope')" in str(excinfo.value)
+    
+    # Boolean error
+    conf.write_text("strict-vscode = 'yes'")
+    with pytest.raises(ConfigError) as excinfo:
+        load_config(conf)
+    assert "Config key 'strict-vscode' must be true or false (got 'yes')" in str(excinfo.value)
+    
+    # String error
+    conf.write_text("format = 5")
+    with pytest.raises(ConfigError) as excinfo:
+        load_config(conf)
+    assert "Config key 'format' must be a string (got 5)" in str(excinfo.value)
+
+def test_fallback_parser_comments():
+    from skillcheck.config_loader import _parse_without_tomllib
+    
+    # Test inline comment stripping
+    raw = 'format = "json" # This is a comment\n'
+    parsed = _parse_without_tomllib(raw)
+    assert parsed["format"] == "json"
+    
+    # Test # inside quotes
+    raw = 'format = "json # not a comment" # This IS a comment\n'
+    parsed = _parse_without_tomllib(raw)
+    assert parsed["format"] == "json # not a comment"
+    
+    # Test # inside array
+    raw = 'ignore = ["file#1.txt", "file#2.txt"] # comment\n'
+    parsed = _parse_without_tomllib(raw)
+    assert parsed["ignore"] == ["file#1.txt", "file#2.txt"]
