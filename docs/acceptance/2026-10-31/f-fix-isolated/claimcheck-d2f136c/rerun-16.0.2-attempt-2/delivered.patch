diff --git a/src/adapters/vitest-run.test.ts b/src/adapters/vitest-run.test.ts
new file mode 100644
index 0000000..1e0a6d0
--- /dev/null
+++ b/src/adapters/vitest-run.test.ts
@@ -0,0 +1,36 @@
+import { describe, it, expect } from "vitest";
+import { runVitest } from "./vitest-run.js";
+import { mkdtemp, writeFile, rm, symlink } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+
+describe("runVitest", () => {
+  it("reports failedToRun when a test file cannot load", async () => {
+    const dir = await mkdtemp(join(tmpdir(), "vitest-run-test-"));
+    try {
+      await writeFile(join(dir, "package.json"), JSON.stringify({
+        name: "test-run",
+        type: "module",
+        devDependencies: { vitest: "latest" }
+      }));
+      
+      // Create a test file that will fail to load due to a syntax error
+      await writeFile(join(dir, "broken.test.ts"), "import { test } from 'vitest'; test('fail', () => {");
+      
+      // Symlink the project's node_modules so runVitest can find the vitest binary
+      const projectNodeModules = join(process.cwd(), "node_modules");
+      await symlink(projectNodeModules, join(dir, "node_modules"), "junction");
+      
+      const result = await runVitest({
+        cwd: dir,
+        testFiles: ["broken.test.ts"],
+      });
+
+      expect(result.failedToRun).toBe(true);
+      expect(result.passed).toBe(false);
+      expect(result.outcomes).toHaveLength(0);
+    } finally {
+      await rm(dir, { recursive: true, force: true });
+    }
+  });
+});
