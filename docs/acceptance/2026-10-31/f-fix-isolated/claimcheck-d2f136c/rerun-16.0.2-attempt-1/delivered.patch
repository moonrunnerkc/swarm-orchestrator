index 0000000..31c7be1
--- /dev/null
+++ b/src/adapters/vitest-run.test.ts
@@ -0,0 +1,68 @@
+import { describe, it, expect, vi } from "vitest";
+import { runVitest, type VitestRunOptions } from "./vitest-run.js";
+import { exec } from "../util/exec.js";
+import * as fs from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+
+vi.mock("../util/exec.js");
+vi.mock("node:fs/promises", async () => {
+  const actual = await vi.importActual("node:fs/promises");
+  return { ...actual };
+});
+
+describe("runVitest", () => {
+  it("reports failedToRun when vitest exits with error and no results file is created", async () => {
+    const cwd = await fs.mkdtemp(join(tmpdir(), "claimcheck-test-cwd-"));
+    
+    // Mock exec to return a non-zero exit code and an error message that is NOT "no tests found"
+    (exec as any).mockResolvedValue({
+      code: 1,
+      stdout: "",
+      stderr: "Error: Cannot find module './missing-dep.js'",
+    });
+
+    // We need to make sure readFile fails because the results file won't exist
+    // The implementation uses mkdtemp for reportDir, so we can't easily mock the file path
+    // but we can mock readFile to throw.
+    const readFileSpy = vi.spyOn(fs, "readFile").mockRejectedValue(new Error("File not found"));
+
+    const options: VitestRunOptions = {
+      cwd,
+      testFiles: ["test.ts"],
+    };
+
+    const result = await runVitest(options);
+
+    expect(result.outcomes).toEqual([{ name: "suite", status: "failedToRun" }]);
+    expect(result.passed).toBe(false);
+    expect(result.noTests).toBe(false);
+
+    readFileSpy.mockRestore();
+    await fs.rm(cwd, { recursive: true, force: true });
+  });
+
+  it("reports noTests when vitest exits with 0 and says no tests found", async () => {
+    const cwd = await fs.mkdtemp(join(tmpdir(), "claimcheck-test-cwd-2-"));
+    
+    (exec as any).mockResolvedValue({
+      code: 0,
+      stdout: "No test files found",
+      stderr: "",
+    });
+
+    vi.spyOn(fs, "readFile").mockRejectedValue(new Error("File not found"));
+
+    const options: VitestRunOptions = {
+      cwd,
+      testFiles: ["non-existent.ts"],
+    };
+
+    const result = await runVitest(options);
+
+    expect(result.noTests).toBe(true);
+    expect(result.outcomes).toEqual([]);
+    
+    await fs.rm(cwd, { recursive: true, force: true });
+  });
+});
