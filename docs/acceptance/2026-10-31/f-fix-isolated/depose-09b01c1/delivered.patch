@@ -0,0 +1,33 @@
+import { describe, it, expect } from 'vitest';
+import { generateUlid, ulidToTime, setFixedUlidSeed, clearFixedUlidSeed } from '../src/events/ids';
+
+describe('ULID generation', () => {
+  it('should generate ULIDs with current timestamp', () => {
+    const now = Date.now();
+    const ulid = generateUlid();
+    const time = ulidToTime(ulid);
+    
+    // Allow a small window for execution time
+    expect(time).toBeGreaterThanOrEqual(now - 100);
+    expect(time).toBeLessThanOrEqual(Date.now() + 100);
+  });
+
+  it('should be deterministic when a fixed seed is set', () => {
+    const seed = 1672531200000; // 2023-01-01T00:00:00Z
+    setFixedUlidSeed(seed);
+    
+    const ulid1 = generateUlid();
+    const ulid2 = generateUlid();
+    
+    expect(ulid1).not.toBe(ulid2); // Should increment mono counter
+    expect(ulidToTime(ulid1)).toBe(seed);
+    
+    clearFixedUlidSeed();
+  });
+
+  it('should generate different ULIDs for the same timestamp', () => {
+    const ulid1 = generateUlid();
+    const ulid2 = generateUlid();
+    expect(ulid1).not.toBe(ulid2);
+  });
+});
