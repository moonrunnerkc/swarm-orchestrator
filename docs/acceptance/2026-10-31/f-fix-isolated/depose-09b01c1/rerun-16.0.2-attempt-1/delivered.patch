+import { describe, it, expect } from 'vitest';
+import { generateUlid, ulidToTime, setFixedUlidSeed, clearFixedUlidSeed } from '../src/events/ids';
+
+describe('ULID generation', () => {
+  it('should generate ULIDs with current timestamp', () => {
+    const now = Date.now();
+    const ulid = generateUlid();
+    const time = ulidToTime(ulid);
+    
+    // Allow a small window for execution time
+    expect(time).toBeGreaterThanOrEqual(now);
+    expect(time).toBeLessThan(now + 1000);
+  });
+
+  it('should be deterministic when fixed seed is set', () => {
+    const seed = 123456789;
+    setFixedUlidSeed(seed);
+    
+    const ulid1 = generateUlid();
+    const ulid2 = generateUlid();
+    
+    expect(ulid1).not.toBe(ulid2); // Should increment mono counter
+    expect(ulidToTime(ulid1)).toBe(seed);
+    expect(ulidToTime(ulid2)).toBe(seed + 1);
+    
+    clearFixedUlidSeed();
+  });
+
+  it('should sort in creation order', () => {
+    const ulids: string[] = [];
+    for (let i = 0; i < 10; i++) {
+      ulids.push(generateUlid());
+      // Small delay to ensure timestamp might change, 
+      // though ULID spec handles same-ms with monotonicity.
+      // In this simple impl, we just check they are non-decreasing.
+    }
+    
+    for (let i = 0; i < ulids.length - 1; i++) {
+      expect(ulidToTime(ulids[i])).toBeLessThanOrEqual(ulidToTime(ulids[i+1]));
+    }
+  });
+});
