+++ b/tests/fixtures/tiktoken/SOURCE.txt
@@ -0,0 +1,16 @@
+tiktoken's cl100k_base vocabulary, vendored so the tokenizer tests run with the network closed.
+
+File:     9b5ad71b2ce5302211f9c61530b329a4922fc6a4
+Upstream: https://openaipublic.blob.core.windows.net/encodings/cl100k_base.tiktoken
+SHA-256:  223921b76ee99bde995b7ff738513eef100fb51d18c93597a113bcffe865b2a7
+
+tiktoken caches a downloaded vocabulary in TIKTOKEN_CACHE_DIR under the SHA-1 of its URL,
+which is the file name above, and accepts a cached copy only when its SHA-256 equals the hash
+tiktoken_ext/openai_public.py pins for that URL (the value above, as of tiktoken 0.14.0).
+tests/conftest.py sets TIKTOKEN_CACHE_DIR to this directory for the suite only; nothing under
+src/ reads it.
+
+If a tiktoken release pins a different hash for this URL, tiktoken deletes this file and fetches
+the vocabulary again, and the offline test fails. Replace the file with the new upstream bytes.
+
+LICENSE beside this file is tiktoken's license (MIT), copied from the tiktoken 0.14.0 wheel.
diff --git a/tests/test_tokenizer_offline.py b/tests/test_tokenizer_offline.py
new file mode 100644
index 0000000..bb60897
--- /dev/null
+++ b/tests/test_tokenizer_offline.py
@@ -0,0 +1,45 @@
+"""The suite's tiktoken vocabulary loads with the network closed.
+
+CI's tokenizer job and offline containers would otherwise fetch cl100k_base
+from openaipublic.blob.core.windows.net, and every tiktoken test would fail
+for the network rather than for the code. conftest.py points
+TIKTOKEN_CACHE_DIR at tests/fixtures/tiktoken, which holds the vocabulary
+under the cache key tiktoken derives from its URL.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+_HAS_TIKTOKEN = importlib.util.find_spec("tiktoken") is not None
+
+
+@pytest.mark.skipif(not _HAS_TIKTOKEN, reason="tiktoken extra is not installed")
+def test_cl100k_base_loads_with_the_network_closed(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
+    import tempfile
+
+    import tiktoken
+    import tiktoken.load
+    import tiktoken.registry
+
+    def closed(blobpath: str) -> bytes:
+        if "://" in blobpath:
+            raise OSError(f"network closed in this test; refused {blobpath}")
+        with open(blobpath, "rb") as handle:
+            return handle.read()
+
+    # A warm cache in the machine's temp directory must not satisfy the load:
+    # only the cache the suite configures may.
+    empty = tmp_path / "temp"
+    empty.mkdir()
+    monkeypatch.setattr(tempfile, "gettempdir", lambda: str(empty))
+    monkeypatch.delenv("DATA_GYM_CACHE_DIR", raising=False)
+    monkeypatch.setattr(tiktoken.load, "read_file", closed)
+    monkeypatch.setattr(tiktoken.registry, "ENCODINGS", {})
+
+    encoding = tiktoken.get_encoding("cl100k_base")
+
+    assert encoding.encode("hello world") == [15339, 1917]
