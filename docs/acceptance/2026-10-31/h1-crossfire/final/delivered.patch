diff --git a/test/policy-repro.test.ts b/test/policy-repro.test.ts
new file mode 100644
index 0000000..68c82d3
--- /dev/null
+++ b/test/policy-repro.test.ts
@@ -0,0 +1,37 @@
+import { mkdirSync, mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { describe, expect, test } from "vitest";
+import { createPathScope } from "../src/policy/index.js";
+
+function makeRepo(): string {
+  const repo = mkdtempSync(join(tmpdir(), "crossfire-repro-"));
+  mkdirSync(join(repo, "src"), { recursive: true });
+  return repo;
+}
+
+describe("path scope '..' prefix bug", () => {
+  test("allows a file starting with '..' inside the repo", () => {
+    const repo = makeRepo();
+    const scope = createPathScope(repo, []);
+    
+    const fileName = "..notes.md";
+    const filePath = join(repo, fileName);
+    writeFileSync(filePath, "some notes");
+
+    const decision = scope.check(filePath);
+    expect(decision.allowed).toBe(true);
+    expect(decision.relativePath).toBe(fileName);
+  });
+
+  test("still denies a path that actually escapes the repo", () => {
+    const repo = makeRepo();
+    const scope = createPathScope(repo, []);
+    
+    const filePath = join(repo, "../outside.txt");
+    const decision = scope.check(filePath);
+    
+    expect(decision.allowed).toBe(false);
+    expect(decision.reason).toContain("outside the target repo");
+  });
+});
