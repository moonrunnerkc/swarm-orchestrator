+import { describe, it, expect } from 'vitest';
+import { writeFileSync, mkdirSync, rmSync } from 'node:fs';
+import { join } from 'node:path';
+import { checkMaxFileLength } from '../../src/verifier/filesystem-checks';
+
+describe('checkMaxFileLength', () => {
+  const testDir = join(process.cwd(), 'test-max-length');
+
+  it('should count lines like wc -l (ignoring trailing newline)', () => {
+    if (!mkdirSync(testDir, { recursive: true })) {}
+    
+    const file1 = join(testDir, 'file1.ts');
+    const file2 = join(testDir, 'file2.ts');
+    
+    // 3 lines, ends with newline. wc -l says 3.
+    writeFileSync(file1, 'line1\nline2\nline3\n');
+    // 3 lines, does NOT end with newline. wc -l says 2.
+    writeFileSync(file2, 'line1\nline2\nline3');
+
+    const files = [file1, file2];
+    const results = checkMaxFileLength(files, testDir, 3);
+
+    // Both should pass if limit is 3
+    expect(results).toHaveLength(0);
+
+    const resultsStrict = checkMaxFileLength(files, testDir, 2);
+    // file1 (3 lines) should fail, file2 (2 lines according to wc -l) should pass
+    expect(resultsStrict).toHaveLength(1);
+    expect(resultsStrict[0].file).toContain('file1.ts');
+
+    rmSync(testDir, { recursive: true, force: true });
+  });
+});
