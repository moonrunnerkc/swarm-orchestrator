+        // If the next token looks like another flag, report it as missing value
+        if (raw.startsWith("-")) {
+          throw new Error(
+            `--max-budget-usd requires a numeric value instead of 'got: ${raw}'.`,
+          );
+        }
+        const n = Number(raw);
+        if (!Number.isFinite(n) || n < 0) {
+          throw new Error(
+            `--max-budget-usd requires a non-negative number, got: ${raw}`,
+          );
+        }
+        args.maxBudgetUsd = n;
+        i++;
+        break;
+      }'''
+
+new_block = '''      case "--max-budget-usd": {
+        // Support --max-budget-usd=<n> inline format
+        if (a.includes("=")) {
+          const eqIdx = a.indexOf("=");
+          const raw = a.slice(eqIdx + 1);
+          if (raw === "") {
+            throw new Error("--max-budget-usd requires a numeric value (USD).");
+          }
+          const n = Number(raw);
+          if (!Number.isFinite(n) || n < 0) {
+            throw new Error(
+              `--max-budget-usd requires a non-negative number, got: ${raw}`,
+            );
+          }
+          args.maxBudgetUsd = n;
+          break;
+        }
+        const raw = argv[i + 1];
+        if (raw === undefined) {
+          throw new Error("--max-budget-usd requires a numeric value (USD).");
+        }
+        // If the next token looks like another flag, report it as missing value
+        if (raw.startsWith("-")) {
+          throw new Error(
+            `--max-budget-usd requires a numeric value instead of 'got: ${raw}'.`,
+          );
+        }
+        const n = Number(raw);
+        if (!Number.isFinite(n) || n < 0) {
+          throw new Error(
+            `--max-budget-usd requires a non-negative number, got: ${raw}`,
+          );
+        }
+        args.maxBudgetUsd = n;
+        i++;
+        break;
+      }'''
+
+content = content.replace(old_block, new_block)
+
+with open("src/cli.ts", "w") as f:
+    f.write(content)
+
+print("Done patching src/cli.ts")
