+def test_scan_reports_the_source_line_after_a_multiline_docstring(tmp_path: Path) -> None:
+    """Stripping a docstring must keep its newlines, or every later line number shifts up."""
+    from ironroot.cli.promote import _RNG_PATTERNS, _scan_for_patterns
+
+    fixture = tmp_path / "sampler.py"
+    fixture.write_text(
+        '"""Sampling helpers.\n'
+        "\n"
+        "Nothing here may call random.random() directly.\n"
+        '"""\n'
+        "\n"
+        "def sample():\n"
+        "    '''One draw.\n"
+        "    Uses the seeded generator.\n"
+        "    '''\n"
+        "    return random.random()  # line 10\n"
+    )
+    hits = _scan_for_patterns(tmp_path, _RNG_PATTERNS)
+    assert hits == [(fixture, 10, "return random.random()")]
