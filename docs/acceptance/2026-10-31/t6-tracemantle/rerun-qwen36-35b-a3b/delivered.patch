+"""History package for tracemantle.
+
+This package contains the history I/O, model, and store modules.
+Re-exported at ``tracemantle.core.history_io`` and ``tracemantle.history_store``
+for backward compatibility.
+"""
+from __future__ import annotations
+
+# Re-export public API from submodules
+from tracemantle.history.history_io import (
+    LEDGER_SCHEMA_VERSION,
+    Ledger,
+    LedgerEntry,
+    LedgerError,
+    ResultCounts,
+    RunAgents,
+    ValidationModes,
+    _entry_from_dict,
+    _entry_to_dict,
+    append_run,
+    load_ledger,
+    save_ledger,
+)
+from tracemantle.history.model import (
+    compute_skill_hash,
+    build_entry,
+    check_regression,
+)
+from tracemantle.history.store import (
+    history_identity,
+    append_history,
+    read_history_record,
+    iter_history_records,
+    comparable_runs,
+    migrate_legacy,
+)
+
+__all__ = [
+    "LEDGER_SCHEMA_VERSION",
+    "Ledger",
+    "LedgerEntry",
+    "LedgerError",
+    "ResultCounts",
+    "RunAgents",
+    "ValidationModes",
+    "_entry_from_dict",
+    "_entry_to_dict",
+    "append_run",
+    "load_ledger",
+    "save_ledger",
+    "compute_skill_hash",
+    "build_entry",
+    "check_regression",
+    "history_identity",
+    "append_history",
+    "read_history_record",
+    "iter_history_records",
+    "comparable_runs",
+    "migrate_legacy",
+]
