-def _make_skill(raw: str = "content") -> ParsedSkill:
-    return ParsedSkill(
-        path=Path("/tmp/SKILL.md"),
-        frontmatter={"name": "test", "description": "Tests things."},
-        body="",
-        body_lines=0,
