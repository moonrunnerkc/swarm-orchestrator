+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { walkRepo } from '../../src/adversarial/fs-walk';
+import { mkdirSync, writeFileSync, rmSync } from 'fs';
+import { join } from 'path';
+import { tmpdir } from 'os';
+
+describe('walkRepo', () => {
+  let testDir: string;
+
+  beforeEach(() => {
+    testDir = join(tmpdir(), `dossier-walk-test-${Date.now()}`);
+    mkdirSync(testDir, { recursive: true });
+  });
+
+  afterEach(() => {
+    rmSync(testDir, { recursive: true, force: true });
+  });
+
+  it('should skip .venv directory', () => {
+    const venvDir = join(testDir, '.venv');
+    mkdirSync(venvDir);
+    writeFileSync(join(venvDir, 'pyvenv.cfg'), 'test');
+    writeFileSync(join(testDir, 'main.py'), 'test');
+
+    const files = walkRepo(testDir);
+    expect(files).toEqual(['main.py']);
+    expect(files).not.toContain('.venv/pyvenv.cfg');
+  });
+
+  it('should skip node_modules directory', () => {
+    const nodeModulesDir = join(testDir, 'node_modules');
+    mkdirSync(nodeModulesDir);
+    writeFileSync(join(nodeModulesDir, 'package.json'), 'test');
+    writeFileSync(join(testDir, 'index.js'), 'test');
+
+    const files = walkRepo(testDir);
+    expect(files).toEqual(['index.js']);
+    expect(files).not.toContain('node_modules/package.json');
+  });
+
+  it('should include other directories', () => {
+    const srcDir = join(testDir, 'src');
+    mkdirSync(srcDir);
+    writeFileSync(join(srcDir, 'app.ts'), 'test');
+    writeFileSync(join(testDir, 'package.json'), 'test');
+
+    const files = walkRepo(testDir);
+    expect(files).toEqual(['package.json', 'src/app.ts']);
+  });
+});
