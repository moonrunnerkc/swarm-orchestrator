new file mode 100644
index 0000000..6343020
--- /dev/null
+++ b/src/adapters/worktree-toolchain.test.ts
@@ -0,0 +1,27 @@
+import { describe, expect, it } from "vitest";
+import { strykerVersionFor } from "./worktree-toolchain.js";
+
+/**
+ * The overlay installs a Stryker version matched to the repo's vitest, so the
+ * pinned versions here are the contract: a runner whose vitest peer range does
+ * not cover the repo's vitest is unresolvable and the kill-check silently
+ * degrades. These tests pin the mapping so a Stryker bump (or a new vitest
+ * major) is a deliberate, reviewed change.
+ */
+describe("strykerVersionFor", () => {
+  it("picks the 9.x runner for vitest 2 and newer", () => {
+    for (const major of [2, 3, 4, 5]) {
+      expect(strykerVersionFor(major)).toBe("9.6.1");
+    }
+  });
+
+  it("picks the 8.7 runner for vitest 1 and 0", () => {
+    for (const major of [0, 1]) {
+      expect(strykerVersionFor(major)).toBe("8.7.1");
+    }
+  });
+
+  it("defaults to the 9.x runner when the repo's vitest is unknown", () => {
+    expect(strykerVersionFor(null)).toBe("9.6.1");
+  });
+});
