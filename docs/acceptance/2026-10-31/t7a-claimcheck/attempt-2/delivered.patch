index 0000000..8e09a87
--- /dev/null
+++ b/src/adapters/stryker-version.test.ts
@@ -0,0 +1,20 @@
+import { describe, expect, it } from "vitest";
+import { strykerVersionFor } from "./worktree-toolchain.js";
+
+describe("strykerVersionFor", () => {
+  it("returns the Stryker version for vitest major 1", () => {
+    expect(strykerVersionFor(1)).toBe("8.7.1");
+  });
+
+  it("returns the Stryker version for vitest major 2", () => {
+    expect(strykerVersionFor(2)).toBe("10.1.1");
+  });
+
+  it("returns the Stryker version for vitest major 4", () => {
+    expect(strykerVersionFor(4)).toBe("10.1.1");
+  });
+
+  it("returns the Stryker version when vitest is absent (null)", () => {
+    expect(strykerVersionFor(null)).toBe("10.1.1");
+  });
+});
