+    expect(() => parseArgs(["--reviewers"])).toThrow(
+      /--reviewers flag requires a comma-separated list/,
+    );
+  });
+
+  it("rejects empty --reviewers value", () => {
+    expect(() => parseArgs(["--reviewers", " "])).toThrow(
+      /--reviewers list cannot be empty/,
+    );
+  });
+
+  it("rejects invalid reviewer names", () => {
+    expect(() => parseArgs(["--reviewers", "invalid"])).toThrow(
+      /Invalid reviewer name: invalid/,
+    );
+    expect(() => parseArgs(["--reviewers", "docs,invalid"])).toThrow(
+      /Invalid reviewer name: invalid/,
+    );
+  });
