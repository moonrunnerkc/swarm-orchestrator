+
+function parseReviewers(raw: string | undefined): ReviewerName[] {
+  const valid = Object.keys(REVIEWER_SHORT_NAMES).join(", ");
+  if (raw === undefined || raw.trim() === "") {
+    throw new Error(`--reviewers requires a comma-separated list of: ${valid}.`);
+  }
+  const chosen = new Set<ReviewerName>();
+  for (const name of raw.split(",").map((part) => part.trim())) {
+    const agent = REVIEWER_SHORT_NAMES[name];
+    if (agent === undefined) {
+      throw new Error(`--reviewers got an unknown reviewer "${name}"; choose from: ${valid}.`);
+    }
+    chosen.add(agent);
+  }
+  return REVIEWER_AGENT_NAMES.filter((agent) => chosen.has(agent));
+}
