+const VALID_REVIEWER_SHORT_NAMES = Object.keys(REVIEWER_SHORT_NAMES).join(", ");
+
+function isReviewerShortName(name: string): name is ReviewerShortName {
+  return Object.prototype.hasOwnProperty.call(REVIEWER_SHORT_NAMES, name);
+}
+
+function parseReviewers(raw: string | undefined): ReviewerAgentName[] {
+  const names = (raw ?? "")
+    .split(",")
+    .map((n) => n.trim())
+    .filter((n) => n.length > 0);
+  if (names.length === 0) {
+    throw new Error(
+      `--reviewers requires a comma-separated list of reviewers. Valid names: ${VALID_REVIEWER_SHORT_NAMES}.`,
+    );
+  }
+  const chosen = new Set<ReviewerAgentName>();
+  for (const name of names) {
+    if (!isReviewerShortName(name)) {
+      throw new Error(
+        `--reviewers got an unknown reviewer: ${name}. Valid names: ${VALID_REVIEWER_SHORT_NAMES}.`,
+      );
+    }
+    chosen.add(REVIEWER_SHORT_NAMES[name]);
+  }
+  // Canonical run order regardless of the order typed; the Set drops repeats.
+  return REVIEWER_AGENT_NAMES.filter((n) => chosen.has(n));
+}
