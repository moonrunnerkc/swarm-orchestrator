diff --git a/test/unit/test-weakening-r3-fail-base.test.ts b/test/unit/test-weakening-r3-fail-base.test.ts
new file mode 100644
index 0000000..bf7e3d6
--- /dev/null
+++ b/test/unit/test-weakening-r3-fail-base.test.ts
@@ -0,0 +1,39 @@
+import { describe, it, expect } from "vitest";
+import { compareTestFile } from "../../src/checks/test-weakening.js";
+import { decide } from "../../src/core/decision.js";
+import type { EvidenceRecord } from "../../src/core/evidence-record.js";
+
+describe("R3: test-removed vs assertion-removed", () => {
+  const baseRecord: Partial<EvidenceRecord> = {
+    baseSha: "base", headSha: "head", changedRanges: [], coveredChangedLines: [],
+    headTestsPass: true, failsOnParent: "failed", coverageCollected: true,
+    staticTail: [], vacuousAssertions: [], quarantined: [],
+    taint: [], mutants: [],
+    regressions: [],
+    errorSuppressions: [],
+    nondeterminism: [],
+    testWeakenings: [],
+  };
+
+  it("should not block when a test is removed (this would have blocked on base)", () => {
+    const before = "it('t1', () => { expect(1).toBe(1); }); it('t2', () => { expect(2).toBe(2); });";
+    const after = "it('t1', () => { expect(1).toBe(1); });";
+    
+    const findings = compareTestFile("test.ts", before, after);
+    
+    // On base, this would be 'assertion-removed'
+    // Now it should be 'test-removed'
+    expect(findings.some(f => f.kind === "test-removed")).toBe(true);
+    expect(findings.some(f => f.kind === "assertion-removed")).toBe(false);
+
+    const record = {
+      ...baseRecord,
+      testWeakenings: findings,
+    } as EvidenceRecord;
+    
+    const result = decide(record);
+    // On base, this would be 'block'. Now it must be 'warn'.
+    expect(result.tier).toBe("warn");
+    expect(result.tier).not.toBe("block");
+  });
+});
diff --git a/test/unit/test-weakening-r3-regression-final.test.ts b/test/unit/test-weakening-r3-regression-final.test.ts
new file mode 100644
index 0000000..64fb819
--- /dev/null
+++ b/test/unit/test-weakening-r3-regression-final.test.ts
@@ -0,0 +1,63 @@
+import { describe, it, expect } from "vitest";
+import { compareTestFile } from "../../src/checks/test-weakening.js";
+import { decide } from "../../src/core/decision.js";
+import type { EvidenceRecord } from "../../src/core/evidence-record.js";
+
+describe("R3 Regression: test-removed vs assertion-removed", () => {
+  const baseRecord: Partial<EvidenceRecord> = {
+    baseSha: "base", headSha: "head", changedRanges: [], coveredChangedLines: [],
+    headTestsPass: true, failsOnParent: "failed", coverageCollected: true,
+    staticTail: [], vacuousAssertions: [], quarantined: [],
+    taint: [], mutants: [],
+    regressions: [],
+    errorSuppressions: [],
+    nondeterminism: [],
+    testWeakenings: [],
+  };
+
+  it("should not block when a test is removed (this would have blocked on base)", () => {
+    // Scenario: Deleting a whole test case.
+    // Base behavior: expectCount drops -> assertion-removed -> BLOCK.
+    // New behavior: expectCount drops AND testCount drops -> test-removed -> WARN.
+    const before = "it('t1', () => { expect(1).toBe(1); }); it('t2', () => { expect(2).toBe(2); });";
+    const after = "it('t1', () => { expect(1).toBe(1); });";
+    
+    const findings = compareTestFile("test.ts", before, after);
+    
+    // On base, this would be 'assertion-removed'
+    const testRemoved = findings.find(f => f.kind === "test-removed");
+    const assertionRemoved = findings.find(f => f.kind === "assertion-removed");
+    
+    expect(testRemoved, "Should be identified as test-removed").toBeDefined();
+    expect(assertionRemoved, "Should NOT be identified as assertion-removed").toBeUndefined();
+
+    const record = {
+      ...baseRecord,
+      testWeakenings: findings,
+    } as EvidenceRecord;
+    
+    const result = decide(record);
+    
+    // This is the core of R3: it must be WARN, not BLOCK.
+    expect(result.tier, "Deleting a test should result in WARN, not BLOCK").toBe("warn");
+    expect(result.tier).not.toBe("block");
+  });
+
+  it("should still block when only an assertion is removed", () => {
+    const before = "it('t1', () => { expect(1).toBe(1); expect(2).toBe(2); });";
+    const after = "it('t1', () => { expect(1).toBe(1); });";
+    
+    const findings = compareTestFile("test.ts", before, after);
+    const assertionRemoved = findings.find(f => f.kind === "assertion-removed");
+    
+    expect(assertionRemoved, "Should be identified as assertion-removed").toBeDefined();
+
+    const record = {
+      ...baseRecord,
+      testWeakenings: findings,
+    } as EvidenceRecord;
+    
+    const result = decide(record);
+    expect(result.tier, "Removing an assertion should still result in BLOCK").toBe("block");
+  });
+});
