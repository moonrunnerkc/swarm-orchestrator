@@ -0,0 +1,69 @@
+import { describe, it, expect } from "vitest";
+import { compareTestFile } from "../../src/checks/test-weakening.js";
+import { decide } from "../../src/core/decision.js";
+import type { EvidenceRecord } from "../../src/core/evidence-record.js";
+
+describe("test-weakening", () => {
+  it("reports assertion-removed when expect count drops but test count is same", () => {
+    const before = "it('test', () => { expect(1).toBe(1); expect(2).toBe(2); })";
+    const after = "it('test', () => { expect(1).toBe(1); })";
+    const findings = compareTestFile("test.ts", before, after);
+    
+    expect(findings).toEqual([
+      {
+        file: "test.ts",
+        line: 1,
+        kind: "assertion-removed",
+        detail: "expect() calls dropped from 2 to 1",
+      },
+    ]);
+  });
+
+  it("reports test-removed when expect count drops and test count drops", () => {
+    const before = "it('t1', () => { expect(1).toBe(1); }); it('t2', () => { expect(2).toBe(2); })";
+    const after = "it('t1', () => { expect(1).toBe(1); })";
+    const findings = compareTestFile("test.ts", before, after);
+    
+    expect(findings).toEqual([
+      {
+        file: "test.ts",
+        line: 1,
+        kind: "test-removed",
+        detail: "expect() calls dropped from 2 to 1 (tests dropped from 2 to 1)",
+      },
+    ]);
+  });
+
+  const baseRecord: Partial<EvidenceRecord> = {
+    baseSha: "base", headSha: "head", changedRanges: [], coveredChangedLines: [],
+    headTestsPass: true, failsOnParent: "failed", coverageCollected: true,
+    staticTail: [], vacuousAssertions: [], quarantined: [],
+    taint: [], mutants: [],
+    regressions: [],
+    errorSuppressions: [],
+    nondeterminism: [],
+    testWeakenings: [],
+  };
+
+  it("assertion-removed blocks the verdict", () => {
+    const record: EvidenceRecord = {
+      ...baseRecord,
+      testWeakenings: [
+        { file: "test.ts", line: 1, kind: "assertion-removed", detail: "..." },
+      ],
+    } as EvidenceRecord;
+    const result = decide(record);
+    expect(result.tier).toBe("block");
+  });
+
+  it("test-removed only warns the verdict", () => {
+    const record: EvidenceRecord = {
+      ...baseRecord,
+      testWeakenings: [
+        { file: "test.ts", line: 1, kind: "test-removed", detail: "..." },
+      ],
+    } as EvidenceRecord;
+    const result = decide(record);
+    expect(result.tier).toBe("warn");
+  });
+});
