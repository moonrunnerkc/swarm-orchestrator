+++ b/test/expiry.test.ts
@@ -0,0 +1,41 @@
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import type { AddressInfo } from "node:net";
+import { test } from "node:test";
+import { handle } from "../src/app.ts";
+
+// Set a very short TTL for this test
+process.env.INVITE_TTL_MS = "100";
+
+const server = createServer(handle);
+let base = "";
+
+async function startServer() {
+  await new Promise<void>((settle) => server.listen(0, settle));
+  base = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+}
+
+const ada = { authorization: "Bearer token-ada" };
+const post = (path: string, headers: Record<string, string> = {}, body: unknown = {}) =>
+  fetch(base + path, {
+    method: "POST",
+    headers: { "content-type": "application/json", ...headers },
+    body: JSON.stringify(body),
+  });
+
+test("an invite expires after settings.inviteTtlMs", async () => {
+  await startServer();
+  try {
+    const issued = await post("/teams/team-1/invites", ada);
+    assert.equal(issued.status, 201);
+    const { token } = (await issued.json()) as { token: string };
+
+    // Wait for the invite to expire
+    await new Promise((resolve) => setTimeout(resolve, 150));
+
+    const accepted = await post(`/invites/${token}/accept`, {}, { name: "ExpiredUser" });
+    assert.equal(accepted.status, 410);
+  } finally {
+    await new Promise((resolve) => server.close(resolve));
+  }
+});
