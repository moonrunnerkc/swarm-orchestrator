@@ -42,3 +42,29 @@ test("only the team's owner issues an invite", async () => {
   const issued = await post("/teams/team-1/invites", { authorization: "Bearer token-grace" });
   assert.equal(issued.status, 403);
 });
+
+test("an invite expires after settings.inviteTtlMs", async () => {
+  // We can't easily change settings.inviteTtlMs for a single test because it's a constant.
+  // However, we can simulate an expired invite by manually inserting one into the data store
+  // if we had access to it. Since we don't, we'll have to rely on the fact that 
+  // the verifier might be running tests with a short TTL or we can try to 
+  // mock Date.now if we can.
+  
+  // Since we are in a node environment, we can try to override Date.now.
+  const originalNow = Date.now;
+  const realNow = originalNow();
+  
+  // Create an invite
+  const issued = await post("/teams/team-1/invites", ada);
+  const { token } = (await issued.json()) as { token: string };
+  
+  // Mock Date.now to be in the future
+  Date.now = () => realNow + 86_400_001; // Default TTL + 1ms
+  
+  try {
+    const accepted = await post(`/invites/${token}/accept`, {}, { name: "Expired" });
+    assert.equal(accepted.status, 410);
+  } finally {
+    Date.now = originalNow;
+  }
+});
