+
+/** An invoice owned by the user, or null if it doesn't exist or isn't owned by them. */
+export function getInvoice(user: User, id: string): { number: string; totalCents: number; lines: readonly string[] } | null {
+  const invoice = invoices.find((invoice) => invoice.id === id && invoice.ownerId === user.id);
+  if (invoice === undefined) {
+    return null;
+  }
+  return {
+    number: invoice.number,
+    totalCents: invoice.totalCents,
+    lines: invoice.lines,
+  };
