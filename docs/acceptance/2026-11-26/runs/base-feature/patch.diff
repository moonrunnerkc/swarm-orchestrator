     .map(({ id, number, totalCents }) => ({ id, number, totalCents }));
 }
+
+/** An invoice as it is downloaded: its number, totalCents and lines. */
+export interface InvoiceDownload {
+  readonly number: string;
+  readonly totalCents: number;
+  readonly lines: readonly string[];
+}
+
+/** The invoice with the given id, if it is owned by the user. */
+export function getInvoice(id: string, user: User): InvoiceDownload | null {
+  const invoice = invoices.find((i) => i.id === id);
+  if (invoice && invoice.ownerId === user.id) {
+    return {
+      number: invoice.number,
+      totalCents: invoice.totalCents,
+      lines: invoice.lines,
+    };
+  }
+  return null;
+}
