{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/cli.ts!",
    "scripts/*.mjs",
    "eval/*.mjs"
  ],
  "project": [
    "src/**/*.ts!",
    "!src/**/test-doubles.ts!",
    "scripts/**/*.mjs",
    "eval/**/*.mjs"
  ],
  "ignore": [
    "docs/**"
  ],
  "ignoreBinaries": [
    "harbor"
  ]
}
