{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swarm-orchestrator.dev/schemas/contract/v1.json",
  "title": "Contract Schema v1",
  "description": "v1 contract envelope with three obligation types: file-must-exist, build-must-pass, test-must-pass.",
  "type": "object",
  "required": ["$id", "version", "obligations"],
  "additionalProperties": false,
  "properties": {
    "$id": {
      "type": "string",
      "format": "uri",
      "description": "Unique identifier for this contract definition"
    },
      "version": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
        "description": "Schema version string (semver)"
      },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "description": "Array of obligations that must be satisfied",
      "items": {
        "anyOf": [
          { "$ref": "#/$defs/file-must-exist" },
          { "$ref": "#/$defs/build-must-pass" },
          { "$ref": "#/$defs/test-must-pass" }
        ]
      }
    }
  },
  "$defs": {
    "file-must-exist": {
      "type": "object",
      "description": "A file must exist at the given path after generation completes.",
      "required": ["type", "path"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "file-must-exist",
          "description": "Obligation type: file must exist"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative file path that must exist after generation"
        },
        "description": {
          "type": "string",
          "description": "Optional description of the obligation"
        }
      }
    },
    "build-must-pass": {
      "type": "object",
      "description": "A build command must exit with status zero.",
      "required": ["type", "command"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "build-must-pass",
          "description": "Obligation type: build must pass"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Build command that must succeed"
        },
        "description": {
          "type": "string",
          "description": "Optional description of the obligation"
        }
      }
    },
    "test-must-pass": {
      "type": "object",
      "description": "A test command must exit with status zero.",
      "required": ["type", "command"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "test-must-pass",
          "description": "Obligation type: test must pass"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Test command that must succeed"
        },
        "description": {
          "type": "string",
          "description": "Optional description of the obligation"
        }
      }
    }
  }
}