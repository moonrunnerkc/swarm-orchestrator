diff --git a/attached_assets/Pasted-Quero-investigar-um-problema-estrutural-espec-fico-de-r_1778262854636.txt b/attached_assets/Pasted-Quero-investigar-um-problema-estrutural-espec-fico-de-r_1778262854636.txt
