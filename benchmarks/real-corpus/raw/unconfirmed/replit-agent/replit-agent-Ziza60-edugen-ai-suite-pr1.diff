+function isLikelyCode(text: string): boolean {
+  // Heuristic: presence of ≥2 of these strongly suggests code
+  let signals = 0;
+  if (/[{}();]/.test(text) && /[{}();].*[{}();]/.test(text)) signals++;
+  if (/=>|->|::|<=|>=|!=|==/.test(text)) signals++;
+  if (/^\s{2,}\S/m.test(text)) signals++;
