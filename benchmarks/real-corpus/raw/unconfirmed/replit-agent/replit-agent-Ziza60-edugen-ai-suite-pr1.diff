+  },
+  {
+    kind: "data_structures",
+    matchTitle: /(estruturas?\s+de\s+dados|data\s+structures|listas|dicion[áa]rios|tuplas|conjuntos|sets)/i,
+    allow: ["listas", "dicionários", "tuplas", "conjuntos", "append()", "keys()", "values()", "set()"],
