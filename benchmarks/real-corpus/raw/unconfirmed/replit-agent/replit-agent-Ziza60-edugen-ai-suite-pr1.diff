+RETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public AS $$
+  SELECT EXISTS (
+    SELECT 1 FROM public.workspace_members
+    WHERE user_id = _user_id AND workspace_id = _workspace_id AND status = 'active'
+  );
+$$;
