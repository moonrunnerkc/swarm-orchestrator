+    structured = {
+        "qa": [],
+        "mnemonics": [
+            {
+                "for": "Laws of Motion",
+                "mnemonic": "FANF – Force Accelerates Non-Frozen objects",
+                "explanation": "Newton's second law: F = ma",
+            }
+        ],
+    }
