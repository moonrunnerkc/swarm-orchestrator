+    // "Save" button appears when a PlanCard is in editing mode.
+    const saveBtn = page.getByRole('button', { name: /^save$/i }).first();
+    await expect(saveBtn).toBeVisible({ timeout: 5_000 });
+    await saveBtn.click();
