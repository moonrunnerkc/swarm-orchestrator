+  { key: 'diagrams',  Icon: GitBranch, label: (n) => `${n} ${n === 1 ? 'diagram' : 'diagrams'}`,   color: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-500/20' },
