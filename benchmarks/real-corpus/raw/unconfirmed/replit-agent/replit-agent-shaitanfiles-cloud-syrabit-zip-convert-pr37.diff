+        last_resp = resp
+
+        if stream:
+            resp.raise_for_status()
+            return resp
+
+        if resp.status_code == 429:
+            if attempt == _POST_MAX_RETRIES:
+                break
+            # Respect Retry-After header if present, else exponential back-off
+            retry_after = resp.headers.get("retry-after", "")
+            try:
