+        `https://dash.cloudflare.com/${ACCOUNT_ID}/${ZONE_ID}/caching/cache-reserve`);
+    }
+  }
+
+  // ── Phase 5: Analytics Engine dataset + Durable Object namespace ──────
+  // These resources are provisioned by `wrangler deploy` (not REST API calls).
