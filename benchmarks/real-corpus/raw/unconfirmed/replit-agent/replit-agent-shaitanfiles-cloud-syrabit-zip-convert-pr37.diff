+    let cancelled = false;
+    setLoadingUrl(true);
+    setInviteUrl(FALLBACK_URL);
+    generateTrustpilotInvitationLink()
+      .then((url) => {
+        if (!cancelled) {
+          setInviteUrl(url || FALLBACK_URL);
+          setUrlError(null);
+        }
+      })
