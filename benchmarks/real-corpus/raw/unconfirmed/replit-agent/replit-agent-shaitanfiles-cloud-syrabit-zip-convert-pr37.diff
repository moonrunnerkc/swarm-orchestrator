+                            UpdateOne(
+                                {"_id": cid},
+                                {"$set": {"vector_store": "pinecone", "embedded_at": _now}},
+                                upsert=False,
+                            )
+                            for cid in pinecone_chunk_ids
+                        ]
+                        try:
+                            await db.chunks.bulk_write(_marker_ops, ordered=False)
