+}
+
+test.describe('Admin CMS & Vertex Panel', () => {
+  test.beforeEach(async ({ page }) => {
+    await seedAdminSession(page);
+    await installAdminApiMocks(page);
+  });
+
+  // ── ContentHub ─────────────────────────────────────────────────────────────
+
+  test('ContentHub renders the three tab labels', async ({ page }) => {
