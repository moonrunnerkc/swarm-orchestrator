+    //    status, language allowlist, etc.) don't 404 and pollute the
+    //    error logs the test asserts against. ────────────────────
+    if (method === 'OPTIONS') return route.fulfill({ status: 204, body: '' });
+    return json(200, {});
+  });
+
+  return state;
