+            "published":      ch_as_total,
+            "with_content_as": ch_as_done,
+            "missing_as":     ch_as_total - ch_as_done,
+            "as_coverage_pct": round(ch_as_done / ch_as_total * 100, 1) if ch_as_total else 0,
+        },
+    }
