-template <typename Gemm, bool WithBias>
-typename Gemm::Arguments prepare_sm90_fp8_args(
-    torch::Tensor& out,
-    const torch::Tensor& a,
-    const torch::Tensor& b,
-    const torch::Tensor& scales_a,
-    const torch::Tensor& scales_b,
