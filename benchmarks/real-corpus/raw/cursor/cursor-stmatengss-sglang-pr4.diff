+    # Second prefill: seq=prefix+extend, ext=extend, prefix=prefix_len.
+    seq_lens_cpu, extend_lens_cpu, num_q = to_seq_extend([(seq_len, extend_len)])
+    out = _run_prefill(
+        ctx,
+        pool,
+        kv_full_cpu[prefix_len:].cuda(),
+        ape_cpu.cuda(),
