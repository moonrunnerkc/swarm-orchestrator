+    # CPU planner's emit order for plan_c.
+    base = 0
+    plan_id = 0
+    for b, (seq, ext) in enumerate(seq_extend):
+        for j in range(ext):
+            P = j  # prefix=0 here
+            if (P + 1) % RATIO != 0:
