+/// 64 MiB — leaves headroom for multimodal inputs and OpenAI JSON pass-through bodies,
+/// well above tonic's 4 MiB decode default.
+pub const DEFAULT_GRPC_MAX_MESSAGE_SIZE: usize = 64 * 1024 * 1024;
