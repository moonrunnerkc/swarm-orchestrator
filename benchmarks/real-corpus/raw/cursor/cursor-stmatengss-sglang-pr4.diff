+static STREAM_ERROR_AFTER: OnceLock<Mutex<HashMap<u16, usize>>> = OnceLock::new();
+
+fn get_stream_error_after_config() -> &'static Mutex<HashMap<u16, usize>> {
+    STREAM_ERROR_AFTER.get_or_init(|| Mutex::new(HashMap::new()))
