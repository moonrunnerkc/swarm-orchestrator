diff --git a/python/sglang/srt/layers/moe/deepep_waterfill.py b/python/sglang/srt/layers/moe/deepep_waterfill.py
--- /dev/null
+++ b/python/sglang/srt/layers/moe/deepep_waterfill.py
@@ -0,0 +1,584 @@
