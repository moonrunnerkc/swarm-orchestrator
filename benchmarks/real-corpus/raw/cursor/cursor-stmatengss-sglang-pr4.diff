+            "page_table_1",
+            fused_page_table_1[:rows, :cols],
+            ref_page_table_1[:rows, :cols],
+        )
+
+    # Compare dsa_cache_seqlens only for the region that was updated
+    if forward_mode.is_decode_or_idle():
+        check_tensor_equal(
+            "dsa_cache_seqlens",
+            fused_dsa_cache_seqlens,
+            ref_dsa_cache_seqlens,
+        )
