+        let decode_workers: Vec<Arc<dyn Worker>> = vec![decode0.clone(), decode1.clone()];
+        let combined: Vec<Arc<dyn Worker>> = vec![
+            prefill0.clone(),
+            prefill1.clone(),
+            decode0.clone(),
+            decode1.clone(),
