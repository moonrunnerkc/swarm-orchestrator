+    """
+    assert q.is_cuda
+    assert q.stride(-1) == 1, "Q's last dim must be contiguous"
+    assert q_weight.shape[-1] == head_dim
+    M = q.shape[0] if q.dim() >= 2 else 1
+    BLOCK = triton.next_power_of_2(head_dim)
+
