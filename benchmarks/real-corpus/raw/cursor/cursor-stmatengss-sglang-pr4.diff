+        # B[slot, h*FULL_K + qk_nope + j, r] -- row dim is j (= GEMM N),
+        # column dim is r (= GEMM K).  Transposed access vs step A_q.
+        w_tile = tl.load(
+            w
+            + w_index * w_stride_l
+            + safe_k[:, None] * w_stride_k
+            + (head_row_base + safe_n[None, :]) * w_stride_n,
+            mask=k_mask[:, None] & n_mask,
+            other=0.0,
+        )
